#!/usr/bin/env python3
"""
mgy-quota - Pretty Quota Dashboard TUI for Antigravity (mgy)
Fetches and renders real-time quotas across all profiles side-by-side with high-speed concurrency,
connection pooling, and subscription tier caching.
"""

import os
import sys
import json
import time
import base64
import re
import shutil
import argparse
import subprocess
import urllib.request
import urllib.parse
from datetime import datetime, timezone
from concurrent.futures import ThreadPoolExecutor, as_completed

# Enable ANSI escape sequences and UTF-8 encoding on Windows console host
if sys.platform == "win32":
    try:
        import ctypes
        from ctypes import wintypes
        kernel32 = ctypes.windll.kernel32
        kernel32.SetConsoleOutputCP(65001)
        kernel32.SetConsoleCP(65001)
        # Enable Virtual Terminal Processing (VT100 / ANSI) without spawning cmd.exe via os.system("")
        STD_OUTPUT_HANDLE = -11
        hOut = kernel32.GetStdHandle(STD_OUTPUT_HANDLE)
        if hOut and hOut != -1:
            mode = wintypes.DWORD()
            if kernel32.GetConsoleMode(hOut, ctypes.byref(mode)):
                kernel32.SetConsoleMode(hOut, mode.value | 0x0004)
    except Exception:
        pass
    try:
        if sys.stdout and hasattr(sys.stdout, "reconfigure"):
            sys.stdout.reconfigure(encoding="utf-8")
        if sys.stderr and hasattr(sys.stderr, "reconfigure"):
            sys.stderr.reconfigure(encoding="utf-8")
    except Exception:
        pass

_SSL_CONTEXT = None

def get_ssl_context():
    """Returns a shared, pre-initialized SSL context to avoid reloading system CA bundles per request."""
    global _SSL_CONTEXT
    if _SSL_CONTEXT is None:
        import ssl
        _SSL_CONTEXT = ssl.create_default_context()
    return _SSL_CONTEXT

# Initialize persistent HTTP connection pool (urllib3) for fast Keep-Alive socket reuse
try:
    import urllib3
    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
    _HTTP_POOL = urllib3.PoolManager(
        maxsize=32,
        retries=False,
        timeout=urllib3.Timeout(connect=5.0, read=10.0)
    )
except Exception:
    _HTTP_POOL = None

def http_post_json(url, headers, payload_dict, timeout=10.0):
    """Executes an HTTP POST with JSON body and returns parsed JSON, using connection pooling when available."""
    data_bytes = json.dumps(payload_dict).encode("utf-8")
    req_headers = dict(headers)
    req_headers["Content-Type"] = "application/json"
    req_headers["User-Agent"] = "antigravity"

    if _HTTP_POOL is not None:
        try:
            resp = _HTTP_POOL.request(
                "POST",
                url,
                body=data_bytes,
                headers=req_headers,
                timeout=timeout
            )
            if resp.status >= 400:
                raise Exception(f"HTTP {resp.status}: {resp.data.decode('utf-8', errors='ignore')}")
            return json.loads(resp.data.decode("utf-8"))
        except Exception:
            pass

    req = urllib.request.Request(url, data=data_bytes, headers=req_headers)
    with urllib.request.urlopen(req, context=get_ssl_context(), timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))

# ANSI color codes
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[90m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"

_OAUTH_CLIENT_CACHE = None
_CACHE_LOCK = None

def find_agy_binary():
    """Finds the actual agy binary across platforms for credential extraction."""
    candidates = ["agy", "agy.exe"]
    for name in candidates:
        p = shutil.which(name)
        if p and os.path.exists(p):
            if sys.platform == "win32" and not p.lower().endswith(".exe"):
                exe_candidate = os.path.splitext(p)[0] + ".exe"
                if os.path.exists(exe_candidate):
                    return exe_candidate
            return p

    home = get_real_home()
    common_paths = [
        os.path.join(home, ".local", "bin", "agy.exe" if sys.platform == "win32" else "agy"),
        os.path.join(home, "bin", "agy.exe" if sys.platform == "win32" else "agy"),
        os.path.join(home, "AppData", "Local", "Programs", "antigravity", "agy.exe"),
        os.path.join(home, "AppData", "Local", "agy", "bin", "agy.exe"),
    ]
    for cp in common_paths:
        if os.path.exists(cp):
            return cp
    return None

def get_agy_oauth_client(refresh_token=None):
    """Retrieves Google Antigravity's public OAuth client credentials safely using cache & singleton lock."""
    global _OAUTH_CLIENT_CACHE, _CACHE_LOCK
    if _CACHE_LOCK is None:
        import threading
        _CACHE_LOCK = threading.Lock()

    if _OAUTH_CLIENT_CACHE:
        return _OAUTH_CLIENT_CACHE

    cid = os.environ.get("ANTIGRAVITY_CLIENT_ID")
    sec = os.environ.get("ANTIGRAVITY_CLIENT_SECRET")
    if cid and sec:
        _OAUTH_CLIENT_CACHE = (cid, sec)
        return _OAUTH_CLIENT_CACHE

    # Check persisted local cache file
    cache_file = os.path.join(get_real_home(), ".config", "multigravity-profiles", ".oauth_client.json")
    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r", encoding="utf-8") as f:
                data = json.load(f)
            c = data.get("client_id")
            s = data.get("client_secret")
            if c and s:
                _OAUTH_CLIENT_CACHE = (c, s)
                return _OAUTH_CLIENT_CACHE
        except Exception:
            pass

    with _CACHE_LOCK:
        if _OAUTH_CLIENT_CACHE:
            return _OAUTH_CLIENT_CACHE

        agy_path = find_agy_binary()
        if agy_path and os.path.exists(agy_path):
            try:
                with open(agy_path, "rb") as f:
                    content = f.read()
                cids = list(dict.fromkeys(c.decode() for c in re.findall(rb"[0-9]+-[a-z0-9_]+\.apps\.googleusercontent\.com", content)))
                secs = list(dict.fromkeys(s.decode() for s in re.findall(rb"GOCSPX-[A-Za-z0-9_-]{28}", content)))

                found_c, found_s = None, None
                if refresh_token:
                    for c in cids:
                        for s in secs:
                            try:
                                data = urllib.parse.urlencode({
                                    "client_id": c,
                                    "client_secret": s,
                                    "grant_type": "refresh_token",
                                    "refresh_token": refresh_token
                                }).encode()
                                req = urllib.request.Request("https://oauth2.googleapis.com/token", data=data)
                                with urllib.request.urlopen(req, context=get_ssl_context(), timeout=5) as resp:
                                    t = json.loads(resp.read().decode())
                                    if "access_token" in t:
                                        found_c, found_s = c, s
                                        break
                            except Exception:
                                continue
                        if found_c:
                            break
                elif cids and secs:
                    found_c, found_s = cids[0], secs[0]

                if found_c and found_s:
                    _OAUTH_CLIENT_CACHE = (found_c, found_s)
                    try:
                        os.makedirs(os.path.dirname(cache_file), exist_ok=True)
                        with open(cache_file, "w", encoding="utf-8") as f:
                            json.dump({"client_id": found_c, "client_secret": found_s}, f)
                    except Exception:
                        pass
                    return _OAUTH_CLIENT_CACHE
            except Exception:
                pass

    return None, None

