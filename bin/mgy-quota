METADATA_CACHE_TTL = 43200  # 12 hours TTL for subscription tier and cloud project

def get_real_home():
    real = os.environ.get("REAL_HOME")
    if real and os.path.isdir(real):
        return real
    home = os.environ.get("USERPROFILE") or os.environ.get("HOME") or os.path.expanduser("~")
    for pattern in ("/.config/multigravity-profiles", "\\.config\\multigravity-profiles"):
        if pattern in home:
            return home.split(pattern)[0].rstrip("/\\")
    return os.path.expanduser("~")

def get_profiles_dir():
    custom = os.environ.get("MULTIGRAVITY_PROFILES_DIR")
    if custom:
        return custom
    return os.path.join(get_real_home(), ".config", "multigravity-profiles")

def load_metadata_cache():
    """Loads cached tier and project information to avoid slow loadCodeAssist calls on every run."""
    cache_path = os.path.join(get_profiles_dir(), ".metadata_cache.json")
    if os.path.exists(cache_path):
        try:
            with open(cache_path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_metadata_cache(cache_dict):
    """Persists metadata cache atomically."""
    cache_path = os.path.join(get_profiles_dir(), ".metadata_cache.json")
    try:
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        tmp_path = cache_path + f".tmp.{os.getpid()}"
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(cache_dict, f, indent=2)
        os.replace(tmp_path, cache_path)
    except Exception:
        try:
            with open(cache_path, "w", encoding="utf-8") as f:
                json.dump(cache_dict, f, indent=2)
        except Exception:
            pass

_WINCRED_INITIALIZED = False
_CredRead = None
_CredFree = None
_CREDENTIAL_STRUCT = None

def _init_wincred():
    global _WINCRED_INITIALIZED, _CredRead, _CredFree, _CREDENTIAL_STRUCT
    if _WINCRED_INITIALIZED or sys.platform != "win32":
        return
    try:
        import ctypes
        from ctypes import wintypes

        class CREDENTIAL(ctypes.Structure):
            _fields_ = [
                ("Flags", wintypes.DWORD),
                ("Type", wintypes.DWORD),
                ("TargetName", wintypes.LPWSTR),
                ("Comment", wintypes.LPWSTR),
                ("LastWritten", wintypes.FILETIME),
                ("CredentialBlobSize", wintypes.DWORD),
                ("CredentialBlob", ctypes.POINTER(ctypes.c_byte)),
                ("Persist", wintypes.DWORD),
                ("AttributeCount", wintypes.DWORD),
                ("Attributes", ctypes.c_void_p),
                ("TargetAlias", wintypes.LPWSTR),
                ("UserName", wintypes.LPWSTR),
            ]

        advapi32 = ctypes.windll.advapi32
        cred_read = advapi32.CredReadW
        cred_read.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(ctypes.POINTER(CREDENTIAL))]
        cred_read.restype = wintypes.BOOL

        cred_free = advapi32.CredFree
        cred_free.argtypes = [ctypes.c_void_p]

        _CREDENTIAL_STRUCT = CREDENTIAL
        _CredRead = cred_read
        _CredFree = cred_free
    except Exception:
        pass
    _WINCRED_INITIALIZED = True

def read_wincred(target_names=("gemini:antigravity", "gemini/antigravity")):
    """Reads generic credentials from Windows Credential Manager using standard library ctypes."""
    if sys.platform != "win32":
        return None
    _init_wincred()
    if not _CredRead or not _CREDENTIAL_STRUCT:
        return None
    if isinstance(target_names, str):
        target_names = [target_names]
    try:
        import ctypes
        CRED_TYPE_GENERIC = 1
        for target_name in target_names:
            p_cred = ctypes.POINTER(_CREDENTIAL_STRUCT)()
            if _CredRead(target_name, CRED_TYPE_GENERIC, 0, ctypes.byref(p_cred)):
                try:
                    blob_size = p_cred.contents.CredentialBlobSize
                    blob = ctypes.string_at(p_cred.contents.CredentialBlob, blob_size)
                    return blob.decode("utf-8-sig", errors="ignore")
                finally:
                    if _CredFree:
                        _CredFree(p_cred)
    except Exception:
        pass
    return None

def get_profile_raw_credential(name, profile_path):
    """Retrieves raw credential data from file tokens, Windows Credential Manager, or macOS Keychain."""
    # 1. Check profile-specific token files
    token_candidates = [
        os.path.join(profile_path, ".tokens", "credential.txt"),
        os.path.join(profile_path, ".tokens", "token.json"),
        os.path.join(profile_path, "antigravity-oauth-token"),
        os.path.join(profile_path, ".gemini", "antigravity-cli", "antigravity-oauth-token"),
    ]
    for path in token_candidates:
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8-sig") as f:
                    content = f.read().strip()
                if content:
                    return content
            except Exception:
                pass

    # 2. Platform-specific store
    if sys.platform == "darwin":
        kc = os.path.join(profile_path, "Library", "Keychains", "login.keychain-db")
        if os.path.exists(kc):
            try:
                res = subprocess.run(["security", "unlock-keychain", "-p", "", kc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if res.returncode == 0:
                    cmd = ["security", "find-generic-password", "-s", "gemini", "-a", "antigravity", "-w", kc]
                    raw = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode().strip()
                    if raw:
                        # Cache to profile token file so subsequent calls skip macOS security CLI
                        try:
                            token_file = os.path.join(profile_path, ".tokens", "credential.txt")
                            os.makedirs(os.path.dirname(token_file), exist_ok=True)
                            with open(token_file, "w", encoding="utf-8") as tf:
                                tf.write(raw)
                        except Exception:
                            pass
                        return raw
            except Exception:
                pass
    elif sys.platform == "win32":
        raw = read_wincred()
        if raw:
            return raw

    return None

def get_provider(name, model_id="", mdata=None):
    if mdata:
        api_prov = mdata.get("apiProvider", "")
        model_prov = mdata.get("modelProvider", "")
        if "GOOGLE" in api_prov or "GOOGLE" in model_prov:
            return "Google Gemini"
        if "ANTHROPIC" in api_prov or "ANTHROPIC" in model_prov:
            return "Anthropic Claude"
        if "OPENAI" in api_prov or "OPENAI" in model_prov:
            return "OpenAI"

    mid_lower = (model_id or "").lower()
    if mid_lower.startswith("gemini-") or "gemini" in mid_lower:
        return "Google Gemini"
    if mid_lower.startswith("claude-") or "claude" in mid_lower:
        return "Anthropic Claude"
    if mid_lower.startswith("gpt-") or "gpt" in mid_lower or "oss" in mid_lower:
        return "OpenAI"

    if name.startswith("Claude") or "Anthropic" in name:
        return "Anthropic Claude"
    if name.startswith("Gemini") or "Google" in name:
        return "Google Gemini"
    if name.startswith("GPT") or name.startswith("OSS") or "OpenAI" in name:
        return "OpenAI"
    return "Other"

def parse_gemini_version(model_id, model_name=""):
    """Extracts (major, minor) tuple from a Gemini model ID or display name."""
    for text in (model_id, model_name):
        if not text:
            continue
        m = re.search(r'gemini[- ]+(\d+(?:\.\d+)?)', text, re.IGNORECASE)
        if m:
            v_str = m.group(1)
            parts = v_str.split(".")
            try:
                major = int(parts[0])
                minor = int(parts[1]) if len(parts) > 1 else 0
                return (major, minor)
            except ValueError:
                pass
        m2 = re.match(r'^(\d+(?:\.\d+)?)', text.strip())
        if m2:
            v_str = m2.group(1)
            parts = v_str.split(".")
            try:
                major = int(parts[0])
                minor = int(parts[1]) if len(parts) > 1 else 0
                return (major, minor)
            except ValueError:
                pass
    return None

def is_gemini_min_version(model_dict, min_version=(3, 8)):
    """Returns True if the model is a Google Gemini model with version >= min_version."""
    provider = model_dict.get("provider", "")
    mid = (model_dict.get("id") or "").lower()
    name = (model_dict.get("name") or "").lower()

    # Exclude non-Gemini models (Claude, OpenAI, Other)
    if provider != "Google Gemini" and not mid.startswith("gemini") and not name.startswith("gemini"):
        return False

    ver = parse_gemini_version(mid, name)
    if ver is None:
        return False
    return ver >= min_version

def get_tier_label(tier_id):
    if not tier_id:
        return "STANDARD"
    tier_upper = tier_id.upper()
    if "PRO" in tier_upper:
        return "PRO"
    if "ULTRA" in tier_upper:
        return "ULTRA"
    if "PLUS" in tier_upper:
        return "G1-PLUS-TIER"
    if "FREE" in tier_upper:
        return "FREE"
    return tier_upper.replace("-TIER", "")

def format_duration(seconds):
    if seconds <= 0:
        return "ready"
    s = int(seconds)
    hours = s // 3600
    minutes = (s % 3600) // 60
    secs = s % 60
    if hours > 0:
        return f"{hours}h {minutes:02d}m"
    if minutes > 0:
        return f"{minutes}m {secs:02d}s"
    return f"{secs}s"

def make_progress_bar(pct, width=10):
    filled = int(round((pct / 100.0) * width))
    filled = max(0, min(width, filled))
    empty = width - filled
    return "━" * filled + "─" * empty

def get_color(pct):
    if pct <= 10.0:
        return RED
    if pct <= 30.0:
        return YELLOW
    return GREEN

def parse_delay_str(s):
    if not s:
        return 0
    m = re.match(r'(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?', s)
    if not m:
        return 0
    h = int(m.group(1) or 0)
    mins = int(m.group(2) or 0)
    secs = int(m.group(3) or 0)
    return h * 3600 + mins * 60 + secs

def get_active_lockouts():
    """
    Cleans up any stale quota_lockout.json files. Google's daily-cloudcode-pa API
    is the authoritative source of truth for quota limits.
    """
    profiles_dir = get_profiles_dir()
    if os.path.exists(profiles_dir):
        for p in os.listdir(profiles_dir):
            qf = os.path.join(profiles_dir, p, ".tokens", "quota_lockout.json")
            if os.path.exists(qf):
                try:
                    os.remove(qf)
                except Exception:
                    pass
    return {}

def record_profile_lockout(profile_name):
    return False

def fetch_single_profile(name, profile_path, metadata_cache=None, force_refresh=False, active_lockouts=None):
    result = {
        "profile": name,
        "authenticated": False,
        "tier": "",
        "total_models": 0,
        "models": [],
        "critical_count": 0,
        "low_count": 0,
        "error": None
    }

    raw = get_profile_raw_credential(name, profile_path)
    if not raw:
        result["error"] = "No credentials found for profile"
        return result

    try:
        raw = raw.strip().lstrip("\ufeff")
        if raw.startswith("go-keyring-base64:"):
            payload = json.loads(base64.b64decode(raw.split(":", 1)[1]).decode("utf-8-sig", errors="ignore"))
        else:
            payload = json.loads(raw)
        tok = payload.get("token", {}) if isinstance(payload, dict) and "token" in payload else payload
        if not isinstance(tok, dict):
            tok = {}
        access_token = tok.get("access_token")
        refresh_token = tok.get("refresh_token")
        expiry_str = tok.get("expiry")
        prof_email = payload.get("id_token_email") or payload.get("email") or (tok.get("email") if isinstance(tok, dict) else None)
    except Exception as e:
        result["error"] = f"Failed to parse token: {e}"
        return result

    # Check if cached access_token is still valid
    token_valid = False
    if access_token and expiry_str:
        try:
            exp_dt = datetime.fromisoformat(expiry_str.replace("Z", "+00:00"))
            if (exp_dt - datetime.now(timezone.utc)).total_seconds() > 60:
                token_valid = True
        except Exception:
            pass

    # Refresh OAuth access token if expired or missing
    if not token_valid and refresh_token:
        cid, sec = get_agy_oauth_client(refresh_token)
        if cid and sec:
            try:
                refresh_data = urllib.parse.urlencode({
                    "client_id": cid,
                    "client_secret": sec,
                    "grant_type": "refresh_token",
                    "refresh_token": refresh_token
                }).encode()
                req = urllib.request.Request("https://oauth2.googleapis.com/token", data=refresh_data)
                with urllib.request.urlopen(req, context=get_ssl_context(), timeout=10) as resp:
                    t_data = json.loads(resp.read().decode())
                new_token = t_data.get("access_token")
                if new_token:
                    access_token = new_token
                    # Persist refreshed token to profile token file if available
                    token_file = os.path.join(profile_path, ".tokens", "credential.txt")
                    if os.path.exists(token_file):
                        try:
                            expires_in = t_data.get("expires_in", 3600)
                            tok["access_token"] = new_token
                            tok["expiry"] = datetime.fromtimestamp(time.time() + expires_in, timezone.utc).isoformat()
                            if isinstance(payload, dict) and "token" in payload:
                                payload["token"] = tok
                                save_payload = payload
                            else:
                                save_payload = tok
                            with open(token_file, "w", encoding="utf-8") as tf:
                                json.dump(save_payload, tf, indent=2)
                        except Exception:
                            pass
            except Exception as e:
                if not access_token:
                    result["error"] = f"OAuth refresh error: {e}"
                    return result

    if not access_token:
        result["error"] = "No access token available"
        return result

    result["authenticated"] = True

    # Check tier and project from metadata cache or local tier_cache.json
    tier_cache_file = os.path.join(profile_path, ".tokens", "tier_cache.json")
    cached_meta = (metadata_cache or {}).get(name, {})
    cached_tier = cached_meta.get("tier")
    cached_proj = cached_meta.get("project", "aicode-consumers")
    cached_at = cached_meta.get("cached_at", 0)

    if not cached_tier and os.path.exists(tier_cache_file):
        try:
            with open(tier_cache_file, "r", encoding="utf-8") as tf:
                tdata = json.load(tf)
            if time.time() - tdata.get("time", 0) < 86400:
                cached_tier = tdata.get("tier")
                cached_proj = tdata.get("proj_id") or cached_proj
                cached_at = tdata.get("time", 0)
        except Exception:
            pass

    is_cache_fresh = bool(cached_tier and (time.time() - cached_at < METADATA_CACHE_TTL) and not force_refresh)

    auth_headers = {"Authorization": f"Bearer {access_token}"}
    res2 = None
    res_uqs = None

    def fetch_fam(target_proj):
        try:
            return http_post_json(
                "https://daily-cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels",
                auth_headers,
                {"project": target_proj},
                timeout=10.0
            )
        except Exception:
            return None

    def fetch_uqs(target_proj):
        try:
            return http_post_json(
                "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
                auth_headers,
                {"project": target_proj},
                timeout=10.0
            )
        except Exception:
            return None

    if is_cache_fresh:
        # FAST PATH: Subscription tier is already known from cache.
        # Skip slow loadCodeAssist completely and query available models & quota summary directly in parallel!
        result["tier"] = cached_tier
        proj_id = cached_proj
        with ThreadPoolExecutor(max_workers=2) as inner_ex:
            fut_fam = inner_ex.submit(fetch_fam, proj_id)
            fut_uqs = inner_ex.submit(fetch_uqs, proj_id)
            res2 = fut_fam.result()
            res_uqs = fut_uqs.result()
    else:
        # FULL / CACHE-MISS PATH: Run loadCodeAssist, fetchAvailableModels, and retrieveUserQuotaSummary in parallel
        def fetch_lca():
            try:
                return http_post_json(
                    "https://daily-cloudcode-pa.googleapis.com/v1internal:loadCodeAssist",
                    auth_headers,
                    {"metadata": {"ideType": "ANTIGRAVITY", "platform": "PLATFORM_UNSPECIFIED", "pluginType": "GEMINI"}},
                    timeout=10.0
                )
            except Exception:
                return None

        with ThreadPoolExecutor(max_workers=3) as inner_ex:
            fut_lca = inner_ex.submit(fetch_lca)
            fut_fam = inner_ex.submit(fetch_fam, cached_proj)
            fut_uqs = inner_ex.submit(fetch_uqs, cached_proj)
            res1 = fut_lca.result()
            res2 = fut_fam.result()
            res_uqs = fut_uqs.result()

        if res1:
            tier = (res1.get("paidTier") or {}).get("id") or (res1.get("currentTier") or {}).get("id") or "STANDARD"
            result["tier"] = get_tier_label(tier)
            proj = res1.get("cloudaicompanionProject")
            if isinstance(proj, dict):
                proj_id = proj.get("id") or "aicode-consumers"
            elif isinstance(proj, str) and proj:
                proj_id = proj
            else:
                proj_id = "aicode-consumers"
        else:
            result["tier"] = cached_tier or "PRO"
            proj_id = cached_proj

        if metadata_cache is not None:
            metadata_cache[name] = {
                "tier": result["tier"],
                "project": proj_id,
                "cached_at": time.time()
            }
        try:
            os.makedirs(os.path.dirname(tier_cache_file), exist_ok=True)
            with open(tier_cache_file, "w", encoding="utf-8") as tf:
                json.dump({"tier": result["tier"], "proj_id": proj_id, "time": time.time()}, tf)
        except Exception:
            pass

        if proj_id != cached_proj or res2 is None:
            try:
                res2 = fetch_fam(proj_id)
            except Exception:
                pass
            try:
                res_uqs = fetch_uqs(proj_id)
            except Exception:
                pass

    raw_models = res2.get("models", {}) if res2 else {}
    now_utc = datetime.now(timezone.utc)

    # Parse retrieveUserQuotaSummary to detect group-level weekly subscription limits
    user_quota_summary = res_uqs.get("groups", []) if isinstance(res_uqs, dict) else []

    group_limits = {}
    weekly_limit_depleted = False
    weekly_limit_pct = 100.0
    weekly_reset_str = ""

    for grp in user_quota_summary:
        grp_name = (grp.get("displayName") or "").lower()
        g_dep = False
        g_pct = 100.0
        g_reset = ""
        for bkt in grp.get("buckets", []):
            w = bkt.get("window", "")
            dis = bkt.get("disabled", False)
            rem_frac = bkt.get("remainingFraction")
            r_str = bkt.get("resetTime")
            if w == "weekly":
                if rem_frac is not None:
                    g_pct = min(g_pct, float(rem_frac) * 100.0)
                if rem_frac == 0:
                    g_dep = True
                if r_str and not g_reset:
                    try:
                        dt = datetime.fromisoformat(r_str.replace("Z", "+00:00"))
                        diff = (dt - now_utc).total_seconds()
                        if diff > 0:
                            g_reset = format_duration(diff)
                    except Exception:
                        pass
            elif dis is True and w == "5h":
                g_dep = True
        group_limits[grp_name] = (g_dep, g_pct, g_reset)

    # Check if Google Gemini has a weekly group depletion
    for k, (g_dep, g_p, g_r) in group_limits.items():
        if "gemini" in k and g_dep:
            weekly_limit_depleted = True
            weekly_limit_pct = min(weekly_limit_pct, g_p)
            if g_r:
                weekly_reset_str = g_r

    if weekly_limit_depleted:
        result["weekly_depleted"] = True
        result["weekly_reset"] = weekly_reset_str
        result["weekly_pct"] = weekly_limit_pct

    parsed_models = []
    critical_count = 0
    low_count = 0

    items = raw_models.items() if isinstance(raw_models, dict) else [(m.get("model", ""), m) for m in raw_models]
    total_models = len(items)

    for mid, mdata in items:
        display_name = mdata.get("displayName") or MODEL_DISPLAY_NAMES.get(mid)
        if not display_name:
            if mid.startswith("gemini-"):
                clean = mid.replace("-tiered", " (High)").replace("-", " ")
                display_name = " ".join(word.capitalize() if word.lower() not in ("flash", "pro", "lite", "high") else word.title() for word in clean.split())
            else:
                display_name = mid
        quota_info = mdata.get("quotaInfo") or {}
        reset_str = quota_info.get("resetTime")

        # Skip background completion models that have no reset/quota limit
        if not reset_str:
            continue

        reset_diff = 0
        try:
            dt = datetime.fromisoformat(reset_str.replace("Z", "+00:00"))
            reset_diff = (dt - now_utc).total_seconds()
        except Exception:
            reset_diff = 0

        # CRITICAL PROTOBUF FIX:
        # In Google's Proto3 JSON encoding, default float value 0.0 is omitted.
        # If resetTime is in the future but remainingFraction is absent from quotaInfo,
        # the remaining fraction is 0.0 (quota completely consumed)!
        if "remainingFraction" in quota_info and quota_info["remainingFraction"] is not None:
            rem_frac = float(quota_info["remainingFraction"])
        else:
            rem_frac = 1.0 if reset_diff <= 0 else 0.0

        rem_pct = rem_frac * 100.0
        dur_str = format_duration(reset_diff)

        provider = get_provider(display_name, mid, mdata)

        # Apply group weekly depletion to respective models
        m_weekly_dep = False
        m_weekly_p = 100.0
        m_weekly_r = ""
        if provider == "Google Gemini":
            for k, (g_dep, g_p, g_r) in group_limits.items():
                if "gemini" in k and g_dep:
                    m_weekly_dep = True
                    m_weekly_p = min(m_weekly_p, g_p)
                    m_weekly_r = g_r or m_weekly_r
        else:
            for k, (g_dep, g_p, g_r) in group_limits.items():
                if any(term in k for term in ["claude", "gpt", "3p", "openai", "anthropic"]) and g_dep:
                    m_weekly_dep = True
                    m_weekly_p = min(m_weekly_p, g_p)
                    m_weekly_r = g_r or m_weekly_r

        if m_weekly_dep:
            rem_pct = min(rem_pct, m_weekly_p)
            if m_weekly_r:
                dur_str = m_weekly_r

        if rem_pct <= 10.0:
            critical_count += 1
        elif rem_pct <= 30.0:
            low_count += 1

        parsed_models.append({
            "id": mid,
            "name": display_name,
            "provider": get_provider(display_name, mid, mdata),
            "pct": rem_pct,
            "reset_str": dur_str,
        })

    result["total_models"] = total_models
    result["models"] = parsed_models
    result["critical_count"] = critical_count
    result["low_count"] = low_count
    return result

def render_profile_column(data, width=56, min_version_str="3.8", show_all=False):
    """Renders a single profile's quota dashboard into a list of strings."""
    lines = []
    name = data["profile"]
    tier = data.get("tier") or "PRO"
    models = data.get("models") or []
    total = data.get("total_models", len(models))
    crit = data.get("critical_count", 0)
    low = data.get("low_count", 0)

    lines.append("")
    if show_all:
        lines.append(f"  {BOLD}{CYAN}QUOTA DASHBOARD{RESET}")
    else:
        lines.append(f"  {BOLD}{CYAN}QUOTA DASHBOARD{RESET} {DIM}(Gemini {min_version_str}+){RESET}")
    lines.append(f"  {DIM}{name} [{tier}]{RESET}")
    lines.append("")

    if not data["authenticated"] or data.get("error"):
        lines.append(f"  {RED}● Not authenticated / Error: {data.get('error')}{RESET}")
        lines.append(f"  {DIM}Run: mgy new {name}{RESET}")
        lines.append(f"  {DIM}{'─' * (width - 4)}{RESET}")
        return lines

    if not models:
        lines.append(f"  {DIM}0 models{RESET}")
        lines.append(f"  {DIM}{'─' * (width - 4)}{RESET}")
        lines.append("")
        tag = f"Gemini {min_version_str}+" if not show_all else "quota"
        lines.append(f"  {DIM}(no {tag} models found){RESET}")
        lines.append("")
        return lines

    summary = f"  {DIM}{total} model{'s' if total != 1 else ''}{RESET}"
    if crit > 0:
        summary += f"  {RED}● {crit} critical{RESET}"
    if low > 0:
        summary += f"  {YELLOW}● {low} low{RESET}"
    lines.append(summary)
    if data.get("weekly_depleted"):
        lines.append(f"  {RED}⚠ Weekly limit reached (resets in {data.get('weekly_reset', 'ready')}){RESET}")
    lines.append(f"  {DIM}{'─' * (width - 4)}{RESET}")

    # Group by provider
    groups = {p: [] for p in PROVIDER_ORDER}
    for m in models:
        p = m["provider"]
        if p not in groups:
            groups[p] = []
        groups[p].append(m)

    for prov in PROVIDER_ORDER:
        prov_models = groups.get(prov, [])
        if not prov_models:
            continue

        icon = PROVIDER_ICONS.get(prov, "•")
        lines.append("")
        lines.append(f"  {BOLD}{icon} {prov}{RESET}")

        # Sort models alphabetically by name
        prov_models.sort(key=lambda x: x["name"])

        for m in prov_models:
            dname = m["name"]
            for prefix in ["Gemini ", "Claude ", "GPT-"]:
                if dname.startswith(prefix):
                    dname = dname[len(prefix):]
            if len(dname) > 22:
                dname = dname[:21] + "…"

            bar = make_progress_bar(m["pct"], 10)
            col = get_color(m["pct"])
            pct_val = m["pct"]
            pct_str = f"{pct_val:5.1f}%"
            time_str = f"{m['reset_str']:>8}"

            line = f"    {dname:<22} {bar} {col}{pct_str}{RESET} {DIM}{time_str}{RESET}"
            lines.append(line)

    lines.append("")
    return lines

def strip_ansi(text):
    return re.sub(r'\x1b\[[0-9;]*m', '', text)

def pad_visible(line, target_width):
    visible_len = len(strip_ansi(line))
    padding = max(0, target_width - visible_len)
    return line + (" " * padding)

def get_terminal_width():
    # 1. Environment variable COLUMNS
    if os.environ.get("COLUMNS"):
        try:
            val = int(os.environ["COLUMNS"])
            if val > 0:
                return val
        except ValueError:
            pass

    # 2. Python's os.get_terminal_size() on stdout, stdin, stderr
    for fd in (sys.stdout, sys.stdin, sys.stderr, sys.__stdout__, sys.__stdin__, sys.__stderr__):
        if fd is not None:
            try:
                val = os.get_terminal_size(fd.fileno()).columns
                if val > 0:
                    return val
            except (AttributeError, ValueError, OSError):
                pass

    # 3. Windows CONOUT$ console handle
    if sys.platform == "win32":
        try:
            import ctypes
            import struct
            handle = ctypes.windll.kernel32.CreateFileW("CONOUT$", 0x80000000 | 0x40000000, 1 | 2, None, 3, 0, None)
            if handle != -1 and handle != 0:
                csbi = ctypes.create_string_buffer(22)
                if ctypes.windll.kernel32.GetConsoleScreenBufferInfo(handle, csbi):
                    (bufx, bufy, curx, cury, wattr, left, top, right, bottom, maxx, maxy) = struct.unpack("hhhhHhhhhhh", csbi.raw)
                    width = right - left + 1
                    ctypes.windll.kernel32.CloseHandle(handle)
                    if width > 0:
                        return width
                ctypes.windll.kernel32.CloseHandle(handle)
        except Exception:
            pass

    # 4. /dev/tty ioctl
    try:
        with open("/dev/tty", "r") as f:
            val = os.get_terminal_size(f.fileno()).columns
            if val > 0:
                return val
    except Exception:
        pass

    # 5. tput cols
    try:
        output = subprocess.check_output(["tput", "cols"], stderr=subprocess.DEVNULL).decode().strip()
        val = int(output)
        if val > 0:
            return val
    except Exception:
        pass

    # 6. Fallback
    return shutil.get_terminal_size(fallback=(80, 24)).columns

def render_side_by_side(all_columns, term_width, col_width=56, forced_cols=None):
    """Combines rendered column lists into multi-column layout with │ separator."""
    if forced_cols and forced_cols > 0:
        num_cols = min(forced_cols, len(all_columns))
    else:
        fit_cols = (term_width + 3) // (col_width + 3)
        num_cols = max(1, min(fit_cols, len(all_columns)))

    output_lines = []

    for i in range(0, len(all_columns), num_cols):
        batch = all_columns[i:i + num_cols]
        max_rows = max(len(col) for col in batch)

        padded_batch = []
        for col in batch:
            col_padded = col + [""] * (max_rows - len(col))
            padded_batch.append(col_padded)

        for row_idx in range(max_rows):
            row_parts = []
            for col_idx, col in enumerate(padded_batch):
                line = col[row_idx]
                if col_idx < len(padded_batch) - 1:
                    row_parts.append(pad_visible(line, col_width))
                else:
                    row_parts.append(line)
            
            separator = f" {DIM}│{RESET} "
            output_lines.append(separator.join(row_parts))
        
        output_lines.append("")

    return "\n".join(output_lines)

def run_dashboard(selected_profile=None, forced_cols=None, as_json=False, force_refresh=False, show_all=False, min_gemini="3.8"):
    profiles_dir = get_profiles_dir()
    if not os.path.exists(profiles_dir):
        print(f"No profiles found in {profiles_dir}")
        return

    if selected_profile and selected_profile.lower() in ("quotas", "quota", "quotes", "quote"):
        selected_profile = None

    if selected_profile:
        profile_path = os.path.join(profiles_dir, selected_profile)
        if not os.path.isdir(profile_path):
            print(f"Error: profile '{selected_profile}' does not exist.")
            sys.exit(1)
        targets = [(selected_profile, profile_path)]
    else:
        targets = [
            (d, os.path.join(profiles_dir, d))
            for d in sorted(os.listdir(profiles_dir))
            if os.path.isdir(os.path.join(profiles_dir, d))
        ]

    if not targets:
        print("No profiles found.")
        return

    metadata_cache = load_metadata_cache()

    # Fetch data in parallel across all profiles (network I/O releases GIL; up to 24 concurrent workers)
    active_lockouts = get_active_lockouts()
    results = []
    worker_count = max(1, min(len(targets), 24))
    with ThreadPoolExecutor(max_workers=worker_count) as ex:
        futs = {
            ex.submit(fetch_single_profile, name, path, metadata_cache, force_refresh, active_lockouts): name
            for name, path in targets
        }
        for fut in as_completed(futs):
            results.append(fut.result())

    # Save metadata cache for future instant lookups
    try:
        save_metadata_cache(metadata_cache)
    except Exception:
        pass

    # Filter models if not show_all
    min_ver_tuple = (3, 8)
    if min_gemini:
        parts = min_gemini.split(".")
        try:
            min_ver_tuple = (int(parts[0]), int(parts[1]) if len(parts) > 1 else 0)
        except ValueError:
            min_ver_tuple = (3, 8)

    if not show_all:
        for r in results:
            if r.get("models"):
                filtered = [m for m in r["models"] if is_gemini_min_version(m, min_ver_tuple)]
                r["models"] = filtered
                r["total_models"] = len(filtered)
                r["critical_count"] = sum(1 for m in filtered if m["pct"] <= 10.0)
                r["low_count"] = sum(1 for m in filtered if 10.0 < m["pct"] <= 30.0)

    # Maintain original sorted order
    name_order = {name: i for i, (name, _) in enumerate(targets)}
    results.sort(key=lambda x: name_order.get(x["profile"], 0))

    if as_json:
        print(json.dumps(results, indent=2))
        return

    col_width = 56
    rendered_cols = [render_profile_column(r, col_width, min_version_str=min_gemini, show_all=show_all) for r in results]

    term_width = get_terminal_width()
    print(render_side_by_side(rendered_cols, term_width, col_width, forced_cols))

TIER_WEIGHTS = {
    "ULTRA": 3,
    "PRO": 2,
    "G1-PLUS-TIER": 1,
    "STANDARD": 0,
    "FREE": 0,
}

def detect_target_provider_and_model(model_hint=None):
    """Detects the active provider and model name from CLI hint or agy settings.json."""
    model_str = (model_hint or "").strip()
    if not model_str:
        settings_path = os.path.join(get_real_home(), ".gemini", "antigravity-cli", "settings.json")
        if os.path.exists(settings_path):
            try:
                with open(settings_path, "r", encoding="utf-8") as f:
                    sdata = json.load(f)
                model_str = (sdata.get("model") or "").strip()
            except Exception:
                pass

    lower = model_str.lower()
    if any(k in lower for k in ("claude", "opus", "sonnet", "haiku", "anthropic")):
        provider = "Anthropic Claude"
    elif any(k in lower for k in ("gpt", "oss", "openai", "o1", "o3")):
        provider = "OpenAI"
    else:
        provider = "Google Gemini"
    return provider, model_str

def score_profile_for_model(profile_data, target_provider, target_model=None):
    """Returns (target_pct, overall_pct) for a profile given target provider and optional model."""
    models = profile_data.get("models") or []
    if not models:
        return 0.0, 0.0

    overall_pct = sum(m["pct"] for m in models) / len(models)
    target_pct = None

    if target_model:
        tm_lower = target_model.lower().strip()
        for m in models:
            if m["id"].lower() == tm_lower or m["name"].lower() == tm_lower:
                target_pct = m["pct"]
                break
        if target_pct is None:
            for m in models:
                if tm_lower in m["id"].lower() or tm_lower in m["name"].lower():
                    target_pct = m["pct"]
                    break
        if target_pct is None:
            t_ver = parse_gemini_version(tm_lower, tm_lower)
            if t_ver:
                for m in models:
                    if parse_gemini_version(m["id"], m["name"]) == t_ver:
                        target_pct = m["pct"]
                        break

    if target_pct is None:
        prov_models = [m for m in models if m["provider"] == target_provider]
        if not prov_models and target_provider == "Google Gemini":
            prov_models = [m for m in models if m["provider"] in ("Google Gemini", "Other")]

        if prov_models:
            if target_provider == "Google Gemini":
                gem_38 = [m for m in prov_models if is_gemini_min_version(m, (3, 8))]
                if gem_38:
                    target_pct = sum(m["pct"] for m in gem_38) / len(gem_38)
                else:
                    target_pct = sum(m["pct"] for m in prov_models) / len(prov_models)
            else:
                target_pct = sum(m["pct"] for m in prov_models) / len(prov_models)
        else:
            target_pct = overall_pct

    return float(target_pct), float(overall_pct)

def select_best_profile(exclude_profiles=None, model_hint=None, force_refresh=False):
    """Selects the authenticated profile with the highest remaining quota for the active model/provider."""
    profiles_dir = get_profiles_dir()
    if not os.path.exists(profiles_dir):
        return None

    exclude_set = set()
    if exclude_profiles:
        for p in exclude_profiles.split(","):
            p = p.strip()
            if p:
                exclude_set.add(p)

    targets = [
        (d, os.path.join(profiles_dir, d))
        for d in sorted(os.listdir(profiles_dir))
        if os.path.isdir(os.path.join(profiles_dir, d)) and not d.startswith(".") and d not in exclude_set
    ]
    if not targets:
        return None

    metadata_cache = load_metadata_cache()
    active_lockouts = get_active_lockouts()
    results = []
    worker_count = max(1, min(len(targets), 24))
    with ThreadPoolExecutor(max_workers=worker_count) as ex:
        futs = {
            ex.submit(fetch_single_profile, name, path, metadata_cache, force_refresh, active_lockouts): name
            for name, path in targets
        }
        for fut in as_completed(futs):
            results.append(fut.result())

    try:
        save_metadata_cache(metadata_cache)
    except Exception:
        pass

    target_provider, target_model = detect_target_provider_and_model(model_hint)
    candidates = []
    for r in results:
        if not r.get("authenticated") or r.get("error"):
            continue
        t_pct, o_pct = score_profile_for_model(r, target_provider, target_model)
        if t_pct <= 0.0:
            continue
        tier_w = TIER_WEIGHTS.get(r.get("tier") or "PRO", 0)
        candidates.append((
            round(t_pct, 1),
            tier_w,
            round(o_pct, 1),
            r["profile"],
            r.get("tier") or "PRO",
            t_pct,
            o_pct,
            target_provider,
            target_model,
        ))

    if not candidates:
        return None

    # Sort descending by (tier_weight, target_pct, overall_pct), then ascending by profile name for stability.
    # Higher tier plans (e.g. ULTRA > PRO > G1-PLUS-TIER) are prioritized even if their remaining quota is lower,
    # as long as they have available quota (> 0%).
    candidates.sort(key=lambda x: (-x[1], -x[0], -x[2], x[3]))
    best = candidates[0]
    return {
        "profile": best[3],
        "tier": best[4],
        "target_pct": best[5],
        "overall_pct": best[6],
        "provider": best[7],
        "model": best[8],
    }

def find_latest_conversation_id(since_epoch=None):
    """Finds the most recently active top-level conversation ID, prioritizing the current working directory."""
    import sqlite3
    source_dir = os.path.join(get_real_home(), ".gemini", "antigravity-cli")
    sum_db = os.path.join(source_dir, "conversation_summaries.db")
    conv_dir = os.path.join(source_dir, "conversations")
    cwd_norm = os.getcwd().replace("\\", "/").rstrip("/").lower()

    candidates = []
    if os.path.exists(sum_db):
        try:
            conn = sqlite3.connect(f"file:{sum_db}?mode=ro", uri=True, timeout=2.0)
            rows = conn.execute(
                """
                SELECT conversation_id, last_modified_time, workspace_uris
                FROM conversation_summaries
                WHERE (parent_conversation_id IS NULL OR parent_conversation_id = '')
                  AND (nesting_depth IS NULL OR nesting_depth = 0)
                ORDER BY last_modified_time DESC
                LIMIT 25
                """
            ).fetchall()
            if not rows:
                rows = conn.execute(
                    "SELECT conversation_id, last_modified_time, workspace_uris FROM conversation_summaries ORDER BY last_modified_time DESC LIMIT 25"
                ).fetchall()
            conn.close()
            for cid, lmt, ws_uris in rows:
                if cid:
                    ws_norm = (ws_uris or "").replace("\\", "/").lower()
                    cwd_match = bool(cwd_norm and cwd_norm in ws_norm)
                    candidates.append((cid, lmt, cwd_match))
        except Exception:
            pass

    # Pass 1: Prefer conversation matching the current working directory
    # Pass 2: Any top-level conversation
    for require_cwd in (True, False):
        for cid, lmt, cwd_match in candidates:
            if require_cwd and not cwd_match:
                continue
            db_file = os.path.join(conv_dir, f"{cid}.db")
            wal_file = os.path.join(conv_dir, f"{cid}.db-wal")
            if not os.path.exists(db_file) and not os.path.isdir(os.path.join(source_dir, "brain", cid)):
                continue
            if since_epoch is not None and since_epoch > 0:
                mtime = 0.0
                for p in (wal_file, db_file):
                    if os.path.exists(p):
                        try:
                            mtime = max(mtime, os.path.getmtime(p))
                        except Exception:
                            pass
                if lmt:
                    try:
                        dt = datetime.fromisoformat(lmt.replace("Z", "+00:00"))
                        mtime = max(mtime, dt.timestamp())
                    except Exception:
                        pass
                if mtime < (since_epoch - 5.0):
                    continue
            return cid

    # Fallback: check newest .db file in conversations directory
    if os.path.isdir(conv_dir):
        try:
            db_files = [
                os.path.join(conv_dir, f)
                for f in os.listdir(conv_dir)
                if f.endswith(".db") and len(f) == 39
            ]
            db_files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
            for p in db_files:
                if since_epoch is not None and since_epoch > 0:
                    if os.path.getmtime(p) < (since_epoch - 5.0):
                        continue
                return os.path.splitext(os.path.basename(p))[0]
        except Exception:
            pass

    return None

def has_recent_quota_error(conv_id):
    """Checks if a conversation recently logged a quota or rate-limit exhaustion error."""
    if not conv_id:
        return False
    source_dir = os.path.join(get_real_home(), ".gemini", "antigravity-cli")
    keywords = (
        "resource_exhausted",
        "exhausted your capacity",
        "quota exceeded",
        "quota limit",
        "rate limit",
        "too many requests",
        "individual quota reached",
    )

    # 1. Check transcript.jsonl tail if present
    transcript_path = os.path.join(source_dir, "brain", conv_id, ".system_generated", "logs", "transcript.jsonl")
    if os.path.exists(transcript_path):
        try:
            with open(transcript_path, "rb") as f:
                f.seek(0, os.SEEK_END)
                size = f.tell()
                f.seek(max(0, size - 16384), os.SEEK_SET)
                tail = f.read().decode("utf-8", errors="ignore").lower()
            lines = [ln for ln in tail.splitlines() if ln.strip()][-5:]
            for ln in lines:
                if any(k in ln for k in keywords):
                    return True
        except Exception:
            pass

    # 2. Check last 5 steps in SQLite conversation DB (error_details and step_payload)
    db_path = os.path.join(source_dir, "conversations", f"{conv_id}.db")
    if os.path.exists(db_path):
        try:
            import sqlite3
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1.0)
            rows = conn.execute(
                "SELECT error_details, step_payload FROM steps ORDER BY idx DESC LIMIT 5"
            ).fetchall()
            conn.close()
            for (err_blob, payload_blob) in rows:
                for b in (err_blob, payload_blob):
                    if b:
                        text = (b.decode("utf-8", errors="ignore") if isinstance(b, bytes) else str(b)).lower()
                        if any(k in text for k in keywords):
                            return True
        except Exception:
            pass

    return False

def is_pid_alive(pid):
    if not pid or pid <= 0:
        return False
    if sys.platform == "win32":
        try:
            import ctypes
            from ctypes import wintypes
            kernel32 = ctypes.windll.kernel32
            h = kernel32.OpenProcess(0x1000, False, pid)
            if not h:
                return False
            ec = wintypes.DWORD()
            if kernel32.GetExitCodeProcess(h, ctypes.byref(ec)):
                kernel32.CloseHandle(h)
                return ec.value == 259
            kernel32.CloseHandle(h)
            return True
        except Exception:
            return False
    else:
        try:
            os.kill(pid, 0)
            return True
        except (OSError, ProcessLookupError):
            return False

def find_child_agy_pid(parent_pid):
    if not parent_pid or parent_pid <= 0:
        return None
    if sys.platform == "win32":
        try:
            import ctypes
            from ctypes import wintypes
            class PROCESSENTRY32(ctypes.Structure):
                _fields_ = [
                    ('dwSize', wintypes.DWORD),
                    ('cntUsage', wintypes.DWORD),
                    ('th32ProcessID', wintypes.DWORD),
                    ('th32DefaultHeapID', ctypes.c_size_t),
                    ('th32ModuleID', wintypes.DWORD),
                    ('cntThreads', wintypes.DWORD),
                    ('th32ParentProcessID', wintypes.DWORD),
                    ('pcPriClassBase', wintypes.LONG),
                    ('dwFlags', wintypes.DWORD),
                    ('szExeFile', ctypes.c_char * 260)
                ]

            kernel32 = ctypes.windll.kernel32
            hSnapshot = kernel32.CreateToolhelp32Snapshot(0x00000002, 0)
            if not hSnapshot or hSnapshot == -1:
                return None
            pe = PROCESSENTRY32()
            pe.dwSize = ctypes.sizeof(PROCESSENTRY32)
            found_pid = None
            fallback_pid = None
            if kernel32.Process32First(hSnapshot, ctypes.byref(pe)):
                while True:
                    if pe.th32ParentProcessID == parent_pid:
                        exe = pe.szExeFile.decode('utf-8', errors='ignore').lower()
                        if 'agy' in exe:
                            found_pid = pe.th32ProcessID
                            break
                        elif exe not in ('python.exe', 'pythonw.exe', 'conhost.exe', 'powershell.exe', 'cmd.exe'):
                            fallback_pid = pe.th32ProcessID
                    if not kernel32.Process32Next(hSnapshot, ctypes.byref(pe)):
                        break
            kernel32.CloseHandle(hSnapshot)
            return found_pid or fallback_pid
        except Exception:
            return None
    else:
        try:
            out = subprocess.check_output(["pgrep", "-P", str(parent_pid)], stderr=subprocess.DEVNULL).decode().strip()
            fallback_pid = None
            for line in out.splitlines():
                c_pid = int(line.strip())
                comm = subprocess.check_output(["ps", "-p", str(c_pid), "-o", "comm="], stderr=subprocess.DEVNULL).decode().strip().lower()
                if "agy" in comm:
                    return c_pid
                elif "python" not in comm and "bash" not in comm and "sh" not in comm:
                    fallback_pid = c_pid
            return fallback_pid
        except Exception:
            pass
        return None

def kill_pid_tree(pid):
    if not pid or pid <= 0:
        return
    if sys.platform == "win32":
        try:
            subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
    else:
        try:
            import signal
            try:
                cpids = subprocess.check_output(["pgrep", "-P", str(pid)], stderr=subprocess.DEVNULL).decode().split()
                for c in cpids:
                    kill_pid_tree(int(c.strip()))
            except Exception:
                pass
            os.kill(pid, signal.SIGKILL)
        except Exception:
            pass

def monitor_session(profile, parent_pid, conv_id=None, since_epoch=None):
    """
    Background worker that monitors the active agy session.
    As soon as Gemini quota is depleted, it writes a sentinel file and kills
    the agy process so mgy auto can dynamically switch accounts and resume.
    """
    if since_epoch is None:
        since_epoch = time.time() - 2.0

    marker_file = os.path.join(get_profiles_dir(), f".exhausted_{parent_pid}")
    if os.path.exists(marker_file):
        try:
            os.remove(marker_file)
        except Exception:
            pass

    resolved_conv = conv_id if (conv_id and conv_id != "latest") else None
    last_api_check = time.time()
    source_dir = os.path.join(get_real_home(), ".gemini", "antigravity-cli")
    transcript_offset = 0
    if resolved_conv:
        t_path = os.path.join(source_dir, "brain", resolved_conv, ".system_generated", "logs", "transcript.jsonl")
        if os.path.exists(t_path):
            transcript_offset = max(0, os.path.getsize(t_path) - 2048)

    while True:
        time.sleep(1.2)

        # 1. Exit if parent process is dead
        if parent_pid and not is_pid_alive(parent_pid):
            break

        # 2. Find agy child PID
        agy_pid = find_child_agy_pid(parent_pid) if parent_pid else None

        # 3. Resolve conv_id if not known
        if not resolved_conv:
            found = find_latest_conversation_id(since_epoch=since_epoch)
            if found:
                resolved_conv = found
                t_path = os.path.join(source_dir, "brain", resolved_conv, ".system_generated", "logs", "transcript.jsonl")
                if os.path.exists(t_path):
                    transcript_offset = max(0, os.path.getsize(t_path) - 2048)

        # 4. Check transcript.jsonl and SQLite for actual quota errors
        exhausted = False
        if resolved_conv:
            t_path = os.path.join(source_dir, "brain", resolved_conv, ".system_generated", "logs", "transcript.jsonl")
            if os.path.exists(t_path):
                try:
                    f_size = os.path.getsize(t_path)
                    if f_size > transcript_offset:
                        with open(t_path, "rb") as f:
                            f.seek(transcript_offset, os.SEEK_SET)
                            new_data = f.read().decode("utf-8", errors="ignore").lower()
                        for err_kw in ("resource_exhausted", "exhausted your capacity", "code 429", "quota exceeded", "quota limit", "individual quota reached"):
                            if err_kw in new_data:
                                exhausted = True
                                break
                except Exception:
                    pass

            if not exhausted:
                exhausted = has_recent_quota_error(resolved_conv)

        # 5. If exhausted by a real runtime quota error, write marker and KILL AGY
        if exhausted:
            try:
                record_profile_lockout(profile)
            except Exception:
                pass
            try:
                with open(marker_file, "w", encoding="utf-8") as f:
                    f.write(f"{resolved_conv or ''}|{profile}\n")
            except Exception:
                pass

            if agy_pid and is_pid_alive(agy_pid):
                kill_pid_tree(agy_pid)
            break

def rebind_conversation_trajectory(conv_target, since_epoch=None):
    """
    Rebinds trajectory_meta in SQLite (using the same logic as mgy fork) so a conversation
    can be cleanly resumed across profiles without 'trajectory not found' collisions.
    """
    import sqlite3
    import uuid

    if not conv_target or conv_target.lower() in ("latest", "--continue"):
        conv_id = find_latest_conversation_id(since_epoch=since_epoch)
    else:
        conv_id = conv_target.strip()

    if not conv_id:
        return None

    source_dir = os.path.join(get_real_home(), ".gemini", "antigravity-cli")
    db_path = os.path.join(source_dir, "conversations", f"{conv_id}.db")
    sum_db = os.path.join(source_dir, "conversation_summaries.db")
    lock_file = os.path.join(source_dir, "presence", f"{conv_id}.lock")

    if not os.path.exists(db_path) and not os.path.isdir(os.path.join(source_dir, "brain", conv_id)):
        return None

    if os.path.exists(lock_file):
        try:
            os.remove(lock_file)
        except Exception:
            pass

    new_traj = str(uuid.uuid4())
    old_traj = None

    if os.path.exists(db_path):
        try:
            conn = sqlite3.connect(db_path, timeout=5.0)
            row_meta = conn.execute("SELECT trajectory_id FROM trajectory_meta").fetchone()
            if row_meta and row_meta[0]:
                old_traj = row_meta[0]

            conn.execute("UPDATE trajectory_meta SET cascade_id = ?, trajectory_id = ?", (conv_id, new_traj))
            if old_traj:
                rows = conn.execute("SELECT id, data FROM trajectory_metadata_blob").fetchall()
                for b_id, b_data in rows:
                    if b_data and old_traj.encode("utf-8") in b_data:
                        patched = b_data.replace(old_traj.encode("utf-8"), new_traj.encode("utf-8"))
                        conn.execute("UPDATE trajectory_metadata_blob SET data = ? WHERE id = ?", (patched, b_id))
            conn.commit()
            conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
            conn.close()
        except Exception:
            pass

    if os.path.exists(sum_db) and old_traj:
        try:
            c_sum = sqlite3.connect(sum_db, timeout=5.0)
            row = c_sum.execute("SELECT raw_summary FROM conversation_summaries WHERE conversation_id = ?", (conv_id,)).fetchone()
            if row and row[0]:
                raw = row[0]
                if old_traj.encode("utf-8") in raw:
                    patched_raw = raw.replace(old_traj.encode("utf-8"), new_traj.encode("utf-8"))
                    c_sum.execute(
                        "UPDATE conversation_summaries SET raw_summary = ? WHERE conversation_id = ?",
                        (patched_raw, conv_id)
                    )
                    c_sum.commit()
                    c_sum.execute("PRAGMA wal_checkpoint(PASSIVE);")
            c_sum.close()
        except Exception:
            pass

    return conv_id

def set_clipboard_text(text: str) -> bool:
    """Sets text to system clipboard across Windows, macOS, and Linux."""
    if not text:
        return False
    if sys.platform == "win32":
        # Prefer powershell Set-Clipboard
        try:
            p = subprocess.run(
                ["powershell", "-NoProfile", "-Command", "Set-Clipboard -Value $input"],
                input=text,
                text=True,
                capture_output=True,
                timeout=5.0
            )
            if p.returncode == 0:
                return True
        except Exception:
            pass
        # Fallback to clip.exe
        try:
            p = subprocess.run(["clip.exe"], input=text, text=True, capture_output=True, timeout=3.0)
            if p.returncode == 0:
                return True
        except Exception:
            pass
    elif sys.platform == "darwin":
        try:
            p = subprocess.run(["pbcopy"], input=text.encode("utf-8"), capture_output=True, timeout=3.0)
            if p.returncode == 0:
                return True
        except Exception:
            pass
    else:
        # Linux / BSD: Try wl-copy (Wayland), xclip, xsel
        for tool, args in [("wl-copy", []), ("xclip", ["-selection", "clipboard"]), ("xsel", ["--clipboard", "--input"])]:
            try:
                p = subprocess.run([tool] + args, input=text.encode("utf-8"), capture_output=True, timeout=3.0)
                if p.returncode == 0:
                    return True
            except Exception:
                continue
    return False

def inject_terminal_repl(text: str, delay_sec: float = 1.5) -> bool:
    """
    Pastes text directly into the active interactive terminal REPL (agy > prompt)
    and presses Enter. Also copies text to clipboard as a seamless fallback.
    """
    # 1. Put prompt on clipboard
    try:
        set_clipboard_text(text)
    except Exception:
        pass

    if delay_sec > 0:
        time.sleep(delay_sec)

    success = False

    if sys.platform == "win32":
        # Windows: inject characters directly into console input buffer via WriteConsoleInputW
        # Retry over a short window (e.g. 4 seconds) to ensure the REPL (bubbletea cancelreader)
        # has initialized and flushed its initial startup buffer.
        import ctypes
        from ctypes import wintypes

        class KEY_EVENT_RECORD(ctypes.Structure):
            _fields_ = [
                ("bKeyDown", wintypes.BOOL),
                ("wRepeatCount", wintypes.WORD),
                ("wVirtualKeyCode", wintypes.WORD),
                ("wVirtualScanCode", wintypes.WORD),
                ("uChar", wintypes.WCHAR),
                ("dwControlKeyState", wintypes.DWORD),
            ]

        class INPUT_RECORD(ctypes.Structure):
            class _EVENT(ctypes.Union):
                _fields_ = [("KeyEvent", KEY_EVENT_RECORD)]
            _anonymous_ = ("_EVENT",)
            _fields_ = [
                ("EventType", wintypes.WORD),
                ("_EVENT", _EVENT),
            ]

        kernel32 = ctypes.windll.kernel32
        CreateFileW = kernel32.CreateFileW
        CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
        CreateFileW.restype = wintypes.HANDLE

        def write_records_to_conin(records_arr):
            h = CreateFileW("CONIN$", 0xC0000000, 3, None, 3, 0, None)
            if not h or h == -1:
                return False
            written = wintypes.DWORD()
            ok = kernel32.WriteConsoleInputW(h, records_arr, len(records_arr), ctypes.byref(written))
            kernel32.CloseHandle(h)
            return bool(ok and written.value > 0)

        chars_to_send = text + "\r"
        records = (INPUT_RECORD * (len(chars_to_send) * 2))()
        for i, ch in enumerate(chars_to_send):
            vk = 0x0D if ch == "\r" else 0
            records[i * 2].EventType = 1
            records[i * 2].bKeyDown = True
            records[i * 2].wRepeatCount = 1
            records[i * 2].wVirtualKeyCode = vk
            records[i * 2].uChar = ch

            records[i * 2 + 1].EventType = 1
            records[i * 2 + 1].bKeyDown = False
            records[i * 2 + 1].wRepeatCount = 1
            records[i * 2 + 1].wVirtualKeyCode = vk
            records[i * 2 + 1].uChar = ch

        # Bubbletea takes between 1.0s and 2.5s to mount and call FlushConsoleInputBuffer.
        # We inject multiple waves: at delay_sec, delay_sec + 0.8s, and delay_sec + 1.6s
        # Also simulate Ctrl+V via WScript.Shell
        try:
            write_records_to_conin(records)
            success = True
        except Exception:
            pass

        # Try a second wave slightly later to catch REPL after it flushes boot input
        time.sleep(1.0)
        try:
            write_records_to_conin(records)
        except Exception:
            pass

        # In Windows Terminal, pasting (> 5 KiB or multiline) opens a safety dialog:
        # "You are about to paste text that is very large (more than 5 KiB)..."
        # Pressing Enter the first time confirms the paste dialog ("Paste anyway"),
        # and pressing Enter a second time submits the pasted command to the agy prompt.
        try:
            ps_cmd = (
                "$wshell = New-Object -ComObject WScript.Shell; "
                "$wshell.SendKeys('^v'); "
                "Start-Sleep -Milliseconds 300; "
                "$wshell.SendKeys('{ENTER}'); "
                "Start-Sleep -Milliseconds 400; "
                "$wshell.SendKeys('{ENTER}')"
            )
            subprocess.run(["powershell", "-NoProfile", "-Command", ps_cmd], timeout=4.0, capture_output=True)
            success = True
        except Exception:
            pass
    elif sys.platform == "darwin":
        # macOS: activate terminal application and paste via AppleScript
        try:
            def find_terminal_pid():
                p = os.getppid()
                while p > 1:
                    try:
                        out = subprocess.check_output(["ps", "-p", str(p), "-o", "ppid=,comm="]).decode().strip()
                        ppid_str, comm = out.split(None, 1)
                        if ".app" in comm:
                            return p
                        p = int(ppid_str)
                    except Exception:
                        break
                return None

            term_pid = find_terminal_pid()
            act_cmd = f"try\nset termProc to first process whose unix id is {term_pid}\nset frontmost of termProc to true\nend try\ndelay 0.2\n" if term_pid else ""
            osa = f"""
tell application "System Events"
{act_cmd}
    try
        tell termProc to keystroke "v" using command down
        delay 0.15
        tell termProc to key code 36
    on error
        keystroke "v" using command down
        delay 0.15
        key code 36
    end try
end tell
"""
            subprocess.run(["osascript", "-e", osa], capture_output=True, timeout=4.0)
            success = True
        except Exception:
            pass
    else:
        # Linux / Raspberry Pi: inject into controlling tty if supported
        clean_text = text.rstrip("\r\n").replace("\r\n", "\n").replace("\r", "\n")
        bytes_to_send = clean_text.encode("utf-8") + b"\r"
        try:
            import fcntl
            import termios
            for tty_path in ["/dev/tty", sys.stdin.name if hasattr(sys.stdin, "name") else None]:
                if not tty_path:
                    continue
                try:
                    with open(tty_path, "w") as tty:
                        for b in bytes_to_send:
                            fcntl.ioctl(tty.fileno(), termios.TIOCSTI, bytes([b]))
                        success = True
                        break
                except Exception:
                    continue
        except Exception:
            pass

        if not success:
            # Fallback for systems where TIOCSTI is restricted (e.g. Linux 6.2+ legacy_tiocsti=0)
            # Try xdotool (X11) or wtype (Wayland)
            import shutil
            try:
                if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wtype"):
                    subprocess.run(["wtype", clean_text], timeout=3.0, capture_output=True)
                    time.sleep(0.05)
                    subprocess.run(["wtype", "-k", "Return"], timeout=2.0, capture_output=True)
                    success = True
                elif os.environ.get("DISPLAY") and shutil.which("xdotool"):
                    subprocess.run(["xdotool", "type", "--clearmodifiers", "--delay", "0", clean_text], timeout=3.0, capture_output=True)
                    time.sleep(0.05)
                    subprocess.run(["xdotool", "key", "Return"], timeout=2.0, capture_output=True)
                    success = True
            except Exception:
                pass

    return success

def main():
    parser = argparse.ArgumentParser(description="mgy Quota Dashboard TUI & Profile Selector")
    parser.add_argument("profile", nargs="?", help="Optional specific profile name")
    parser.add_argument("--profile", dest="profile_flag", type=str, default="", help="Profile name flag")
    parser.add_argument("-w", "--watch", type=int, nargs="?", const=10, help="Live watch mode with refresh interval in seconds")
    parser.add_argument("-c", "--cols", "--columns", type=int, help="Force number of side-by-side columns")
    parser.add_argument("-1", dest="cols_1", action="store_true", help="Display 1 column")
    parser.add_argument("-2", dest="cols_2", action="store_true", help="Display 2 columns side-by-side")
    parser.add_argument("-3", dest="cols_3", action="store_true", help="Display 3 columns side-by-side")
    parser.add_argument("-4", dest="cols_4", action="store_true", help="Display 4 columns side-by-side")
    parser.add_argument("-r", "--refresh", "--force-refresh", action="store_true", help="Force fresh retrieval of subscription tiers & models")
    parser.add_argument("-a", "--all", "--all-models", action="store_true", help="Display quotas for all models (including Claude, OpenAI, and older Gemini)")
    parser.add_argument("--min-gemini", type=str, default="3.8", help="Minimum Gemini version to display (default: 3.8)")
    parser.add_argument("--json", action="store_true", help="Output raw JSON")
    parser.add_argument("--best", action="store_true", help="Select and print the profile with the highest remaining quota")
    parser.add_argument("--best-format", choices=["name", "detail", "json"], default="name", help="Output format for --best")
    parser.add_argument("--exclude", type=str, default="", help="Comma-separated profile names to exclude from --best")
    parser.add_argument("--model", type=str, default="", help="Optional model name/ID hint for quota evaluation")
    parser.add_argument("--check-exhausted", type=str, metavar="PROFILE", help="Check if PROFILE has exhausted its quota (0%% remaining)")
    parser.add_argument("--conv-id", type=str, default="", help="Optional conversation ID for --check-exhausted")
    parser.add_argument("--rebind", type=str, metavar="CONV_ID_OR_LATEST", help="Rebind trajectory_meta in SQLite for cross-profile resume")
    parser.add_argument("--find-active-conv", action="store_true", help="Print the most recently active top-level conversation ID")
    parser.add_argument("--since", type=float, default=0.0, help="Optional Unix timestamp filter for --rebind and --find-active-conv")
    parser.add_argument("--monitor-session", action="store_true", help="Run background monitor to kill agy process when quota depletes")
    parser.add_argument("--parent-pid", type=int, default=0, help="Parent PID to monitor")
    parser.add_argument("--record-lockout", metavar="PROFILE", help="Inspect and record active quota lockout for PROFILE")
    parser.add_argument("--inject-repl", type=str, metavar="PROMPT", help="Inject prompt text into active interactive agy REPL")
    parser.add_argument("--inject-repl-b64", type=str, metavar="B64_PROMPT", help="Inject base64-encoded prompt text into active interactive agy REPL")
    parser.add_argument("--delay", type=float, default=1.5, help="Delay in seconds before REPL injection (default: 1.5)")
    args = parser.parse_args()

    selected_profile = args.profile or args.profile_flag or ""

    if args.inject_repl_b64:
        try:
            raw_text = base64.b64decode(args.inject_repl_b64.encode("ascii")).decode("utf-8")
            ok = inject_terminal_repl(raw_text, delay_sec=args.delay)
            sys.exit(0 if ok else 1)
        except Exception:
            sys.exit(1)

    if args.inject_repl:
        ok = inject_terminal_repl(args.inject_repl, delay_sec=args.delay)
        sys.exit(0 if ok else 1)

    if args.record_lockout:
        recorded = record_profile_lockout(args.record_lockout)
        if recorded:
            print(f"RECORDED|{args.record_lockout}")
            sys.exit(0)
        else:
            print(f"NONE|{args.record_lockout}")
            sys.exit(1)

    if args.monitor_session:
        monitor_session(selected_profile, args.parent_pid, conv_id=args.conv_id, since_epoch=args.since if args.since > 0 else None)
        sys.exit(0)

    if args.rebind:
        cid = rebind_conversation_trajectory(args.rebind, since_epoch=args.since if args.since > 0 else None)
        if cid:
            print(cid)
            sys.exit(0)
        sys.exit(1)

    if args.find_active_conv:
        cid = find_latest_conversation_id(since_epoch=args.since if args.since > 0 else None)
        if cid:
            print(cid)
            sys.exit(0)
        sys.exit(1)

    if args.check_exhausted:
        prof = args.check_exhausted
        p_path = os.path.join(get_profiles_dir(), prof)
        if not os.path.isdir(p_path):
            sys.exit(2)
        meta_cache = load_metadata_cache()
        data = fetch_single_profile(prof, p_path, meta_cache, force_refresh=args.refresh)
        target_prov, target_mod = detect_target_provider_and_model(args.model)
        t_pct, _ = score_profile_for_model(data, target_prov, target_mod)
        conv_err = has_recent_quota_error(args.conv_id) if args.conv_id else False
        if (data.get("authenticated") and not data.get("error") and t_pct <= 0.0) or conv_err:
            print(f"EXHAUSTED|{t_pct:.1f}|{target_prov}|{target_mod}")
            sys.exit(0)
        else:
            print(f"OK|{t_pct:.1f}|{target_prov}|{target_mod}")
            sys.exit(1)

    if args.best:
        best = select_best_profile(exclude_profiles=args.exclude, model_hint=args.model, force_refresh=args.refresh)
        if not best:
            sys.exit(1)
        if args.best_format == "json" or args.json:
            print(json.dumps(best))
        elif args.best_format == "detail":
            print(f"{best['profile']}|{best['tier']}|{best['target_pct']:.1f}|{best['overall_pct']:.1f}|{best['provider']}")
        else:
            print(best["profile"])
        sys.exit(0)

    forced_cols = args.cols
    if args.cols_1: forced_cols = 1
    elif args.cols_2: forced_cols = 2
    elif args.cols_3: forced_cols = 3
    elif args.cols_4: forced_cols = 4

    show_all = args.all or (os.environ.get("MGY_QUOTA_ALL") in ("1", "true", "TRUE"))

    prof_arg = selected_profile or None
    if args.watch:
        try:
            while True:
                # Clear terminal screen
                sys.stdout.write("\033[H\033[2J")
                sys.stdout.flush()
                run_dashboard(prof_arg, forced_cols, as_json=args.json, force_refresh=args.refresh, show_all=show_all, min_gemini=args.min_gemini)
                time.sleep(args.watch)
        except KeyboardInterrupt:
            print("\nExiting watch mode.")
    else:
        run_dashboard(prof_arg, forced_cols, as_json=args.json, force_refresh=args.refresh, show_all=show_all, min_gemini=args.min_gemini)

if __name__ == "__main__":
    main()
