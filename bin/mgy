#!/usr/bin/env bash

# mgy (multigravity) - Profile manager for Antigravity CLI (agy)
# Manages isolated credentials, sessions, and configurations per profile.

CMD_NAME="$(basename "$0")"
[ "$CMD_NAME" != "multigravity" ] && CMD_NAME="mgy"

if [[ "$HOME" == *"/.config/multigravity-profiles"* ]]; then
    REAL_HOME="${REAL_HOME:-${HOME%%/.config/multigravity-profiles*}}"
else
    REAL_HOME="${REAL_HOME:-$HOME}"
fi
PROFILES_DIR="${MULTIGRAVITY_PROFILES_DIR:-$REAL_HOME/.config/multigravity-profiles}"

print_help() {
    cat << EOF
Usage: $CMD_NAME [command] [options]

Commands:
  new <profile>          Create a new isolated profile and authenticate
  import <profile>       Import host ~/.gemini session into a profile
  list                   List all existing profiles
  quotas, quota, quotes Check model quota usage across all profiles
  conversations          List recent conversations and their IDs
  fork --conversation=<id> Fork an existing conversation across all other profiles
  delete <profile>       Delete an existing profile
  help, --help, -h       Show this help message
  <profile> [agy args]   Start agy session using the specified profile

Resume & Conversation Flags (same as agy):
  $CMD_NAME <profile> --conversation=<id>   Resume a specific conversation by ID
  $CMD_NAME <profile> -c, --continue       Continue the most recent conversation

Examples:
  $CMD_NAME new <profile>                 # Set up a new profile with Google login
  $CMD_NAME list                          # List all registered profiles
  $CMD_NAME fork --conversation=<id>      # Fork conversation across all profiles
  $CMD_NAME <profile>                     # Start interactive agy session with profile
  $CMD_NAME <profile> -c                  # Continue latest chat under profile
  $CMD_NAME <profile> --conversation=<id> # Resume specific conversation by ID
  $CMD_NAME conversations                 # View list of recent conversation IDs
  $CMD_NAME quotas                        # Inspect quotas across all profiles
EOF
}

usage() {
    print_help
    exit 1
}

setup_profile_environment() {
    local target="$1"

    # Share global ~/.gemini/antigravity-cli (all conversations, history, settings, and MCP tools)
    mkdir -p "$target/.gemini"
    if [ ! -L "$target/.gemini/antigravity-cli" ]; then
        rm -rf "$target/.gemini/antigravity-cli"
        ln -sf "$REAL_HOME/.gemini/antigravity-cli" "$target/.gemini/antigravity-cli"
    fi

    # Preserve git author info and SSH keys if present in user's home
    if [ -f "$REAL_HOME/.gitconfig" ] && [ ! -e "$target/.gitconfig" ]; then
        ln -sf "$REAL_HOME/.gitconfig" "$target/.gitconfig"
    fi
    if [ -d "$REAL_HOME/.ssh" ] && [ ! -e "$target/.ssh" ]; then
        ln -sf "$REAL_HOME/.ssh" "$target/.ssh"
    fi

    # macOS Keychain isolation support (keeps OAuth tokens isolated per account)
    if [[ "$OSTYPE" == "darwin"* ]]; then
        mkdir -p "$target/Library/Keychains"
        # If the profile doesn't have a keychain or symlink, create an isolated keychain for it
        if [ ! -e "$target/Library/Keychains/login.keychain-db" ]; then
            security create-keychain -p "" "$target/Library/Keychains/login.keychain-db" 2>/dev/null || true
        fi
        if [ -f "$target/Library/Keychains/login.keychain-db" ]; then
            security unlock-keychain -p "" "$target/Library/Keychains/login.keychain-db" 2>/dev/null || true
            security default-keychain -s "$target/Library/Keychains/login.keychain-db" 2>/dev/null || true
        fi
    fi
}

is_profile_authenticated() {
    local target="$1"
    if [[ "$OSTYPE" == "darwin"* ]]; then
        HOME="$target" security find-generic-password -s gemini -a antigravity >/dev/null 2>&1
        return $?
    elif [ -f "$target/.tokens/credential.txt" ]; then
        return 0
    elif [ -f "$target/antigravity-oauth-token" ] || [ -f "$target/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
        return 0
    else
        [ -d "$target/.gemini/antigravity-cli" ] && [ -f "$target/.gemini/antigravity-cli/settings.json" ]
        return $?
    fi
}

case "$1" in
    new)
        shift
        PROFILE_NAME="$1"
        [ -z "$PROFILE_NAME" ] && usage
        TARGET_DIR="$PROFILES_DIR/$PROFILE_NAME"

        if [ -d "$TARGET_DIR" ]; then
            echo "Profile '$PROFILE_NAME' already exists at: $TARGET_DIR"
            printf "Re-authenticate profile '%s'? [y/N]: " "$PROFILE_NAME"
            read -r resp
            case "$resp" in
                [yY][eE][sS]|[yY]) ;;
                *) echo "Aborted."; exit 0 ;;
            esac
        fi

        mkdir -p "$TARGET_DIR/.gemini/antigravity-cli"
        setup_profile_environment "$TARGET_DIR"

        echo "Setting up profile '$PROFILE_NAME'..."
        # agy authenticates automatically on startup when unauthenticated.
        # -p "/quota" triggers OAuth login in the browser/terminal and displays quotas once authenticated.
        USERPROFILE="$TARGET_DIR" HOME="$TARGET_DIR" agy -p "/quota" || USERPROFILE="$TARGET_DIR" HOME="$TARGET_DIR" agy || true
        echo "Profile '$PROFILE_NAME' is ready!"
        ;;

    import)
        shift
        PROFILE_NAME="$1"
        [ -z "$PROFILE_NAME" ] && usage
        TARGET_DIR="$PROFILES_DIR/$PROFILE_NAME"

        if [ ! -d "$REAL_HOME/.gemini/antigravity-cli" ]; then
            echo "Error: Default antigravity configuration not found at $REAL_HOME/.gemini/antigravity-cli"
            exit 1
        fi

        if [ -d "$TARGET_DIR" ]; then
            echo "Profile '$PROFILE_NAME' already exists at $TARGET_DIR."
            printf "Overwrite profile '%s' with host session? [y/N]: " "$PROFILE_NAME"
            read -r resp
            case "$resp" in
                [yY][eE][sS]|[yY])
                    rm -rf "$TARGET_DIR"
                    ;;
                *) echo "Aborted."; exit 0 ;;
            esac
        fi

        mkdir -p "$TARGET_DIR/.gemini"
        ln -sf "$REAL_HOME/.gemini/antigravity-cli" "$TARGET_DIR/.gemini/antigravity-cli"
        if [[ "$OSTYPE" == "darwin"* ]]; then
            mkdir -p "$TARGET_DIR/Library"
            ln -sf "$REAL_HOME/Library/Keychains" "$TARGET_DIR/Library/Keychains"
        fi
        setup_profile_environment "$TARGET_DIR"

        echo "Profile '$PROFILE_NAME' imported from global host config!"
        ;;

    list)
        echo "Available profiles:"
        if [ -d "$PROFILES_DIR" ] && [ -n "$(ls -A "$PROFILES_DIR" 2>/dev/null)" ]; then
            ls -1 "$PROFILES_DIR" 2>/dev/null
        else
            echo "(no profiles found)"
        fi
        ;;

    fork)
        shift
        CONV_ID=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --conversation=*)
                    CONV_ID="${1#*=}"
                    shift
                    ;;
                --conversation)
                    CONV_ID="$2"
                    shift 2
                    ;;
                *)
                    [ -z "$CONV_ID" ] && CONV_ID="$1"
                    shift
                    ;;
            esac
        done

        if [ -z "$CONV_ID" ]; then
            echo "Error: Missing conversation ID to fork. Usage: $CMD_NAME fork --conversation=<id>"
            exit 1
        fi

        SOURCE_AGY_DIR="$REAL_HOME/.gemini/antigravity-cli"
        SRC_DB="$SOURCE_AGY_DIR/conversations/$CONV_ID.db"
        SRC_BRAIN="$SOURCE_AGY_DIR/brain/$CONV_ID"

        if [ ! -f "$SRC_DB" ] && [ ! -d "$SRC_BRAIN" ]; then
            echo "Error: Conversation '$CONV_ID' not found at $SOURCE_AGY_DIR"
            exit 1
        fi

        mapfile -t PROFILES < <(ls -1 "$PROFILES_DIR" 2>/dev/null | sort || true)
        if [ "${#PROFILES[@]}" -eq 0 ]; then
            echo "Error: No profiles found in $PROFILES_DIR. Create profiles first with: $CMD_NAME new <profile_name>"
            exit 1
        fi

        FIRST_PROFILE="${PROFILES[0]}"
        echo "Forking conversation '$CONV_ID' across ${#PROFILES[@]} profiles..."
        echo ""
        echo "$CMD_NAME $FIRST_PROFILE --conversation $CONV_ID"

        for ((i=1; i<${#PROFILES[@]}; i++)); do
            P_NAME="${PROFILES[i]}"
            if command -v uuidgen >/dev/null 2>&1; then
                NEW_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
            elif [ -f /proc/sys/kernel/random/uuid ]; then
                NEW_ID=$(cat /proc/sys/kernel/random/uuid)
            else
                NEW_ID=$(python3 -c 'import uuid; print(uuid.uuid4())')
            fi

            # 1. Copy SQLite database files
            DST_DB="$SOURCE_AGY_DIR/conversations/$NEW_ID.db"
            [ -f "$SRC_DB" ] && cp -f "$SRC_DB" "$DST_DB"
            [ -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-wal" ] && cp -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-wal" "$SOURCE_AGY_DIR/conversations/$NEW_ID.db-wal"
            [ -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-shm" ] && cp -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-shm" "$SOURCE_AGY_DIR/conversations/$NEW_ID.db-shm"

            if command -v python3 >/dev/null 2>&1; then
                python3 -c "
import sqlite3, uuid
c = sqlite3.connect('$DST_DB')
new_traj = str(uuid.uuid4())
c.execute(\"UPDATE trajectory_meta SET cascade_id = ?, trajectory_id = ?\", ('$NEW_ID', new_traj))
rows = c.execute(\"SELECT id, data FROM trajectory_metadata_blob\").fetchall()
for b_id, b_data in rows:
    if b_data and '$CONV_ID'.encode('utf-8') in b_data:
        patched = b_data.replace('$CONV_ID'.encode('utf-8'), '$NEW_ID'.encode('utf-8'))
        c.execute(\"UPDATE trajectory_metadata_blob SET data = ? WHERE id = ?\", (patched, b_id))
c.commit()
c.execute(\"PRAGMA wal_checkpoint(TRUNCATE);\")
c.close()
" 2>/dev/null || true
            fi

            # 2. Copy brain directory
            DST_BRAIN="$SOURCE_AGY_DIR/brain/$NEW_ID"
            [ -d "$SRC_BRAIN" ] && cp -rf "$SRC_BRAIN" "$DST_BRAIN"

            # 3. Copy annotations if present
            [ -f "$SOURCE_AGY_DIR/annotations/$CONV_ID.pbtxt" ] && cp -f "$SOURCE_AGY_DIR/annotations/$CONV_ID.pbtxt" "$SOURCE_AGY_DIR/annotations/$NEW_ID.pbtxt"

            # 4. Remove presence lock if exists
            rm -f "$SOURCE_AGY_DIR/presence/$NEW_ID.lock"

            echo "$CMD_NAME $P_NAME --conversation $NEW_ID"
        done
        ;;

    quotas|quota|quotes|quote)
        shift
        if [ -z "$COLUMNS" ]; then
            _cols=$(tput cols 2>/dev/null || stty size 2>/dev/null | awk '{print $2}' || true)
            if [ -n "$_cols" ] && [ "$_cols" -gt 0 ] 2>/dev/null; then
                export COLUMNS="$_cols"
            fi
        fi
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if [ -x "$SCRIPT_DIR/mgy-quota" ]; then
            "$SCRIPT_DIR/mgy-quota" "$@"
            exit $?
        elif command -v mgy-quota >/dev/null 2>&1; then
            mgy-quota "$@"
            exit $?
        fi

        # Fallback to agy -p "/quota" if mgy-quota is not available
        found=0
        if [ -d "$PROFILES_DIR" ]; then
            for profile in "$PROFILES_DIR"/*; do
                if [ -d "$profile" ]; then
                    found=1
                    name=$(basename "$profile")
                    echo -e "\n=== Quota for profile: $name ==="
                    setup_profile_environment "$profile"

                    if is_profile_authenticated "$profile"; then
                        if ! HOME="$profile" agy quota 2>/dev/null; then
                            HOME="$profile" agy -p "/quota"
                        fi
                    else
                        echo "Profile '$name' is not authenticated yet. Run: $CMD_NAME new $name"
                    fi
                fi
            done
        fi
        if [ "$found" -eq 0 ]; then
            echo "(no profiles found in $PROFILES_DIR)"
        fi
        ;;

    delete|rm|remove)
        shift
        PROFILE_NAME="$1"
        [ -z "$PROFILE_NAME" ] && usage
        TARGET_DIR="$PROFILES_DIR/$PROFILE_NAME"

        if [ ! -d "$TARGET_DIR" ]; then
            echo "Error: profile '$PROFILE_NAME' does not exist."
            exit 1
        fi

        printf "Are you sure you want to delete profile '%s'? [y/N]: " "$PROFILE_NAME"
        read -r resp
        case "$resp" in
            [yY][eE][sS]|[yY])
                rm -rf "$TARGET_DIR"
                echo "Profile '$PROFILE_NAME' deleted."
                ;;
            *)
                echo "Aborted."
                ;;
        esac
        ;;

    help|--help|-h)
        print_help
        exit 0
        ;;

    "")
        usage
        ;;

    conversations|history|chats)
        echo "Recent conversations:"
        DB="$REAL_HOME/.gemini/antigravity-cli/conversation_summaries.db"
        if [ -f "$DB" ] && command -v sqlite3 >/dev/null 2>&1; then
            sqlite3 -header -column "$DB" \
              "SELECT conversation_id AS ID, title AS Title, datetime(last_modified_time) AS Last_Active FROM conversation_summaries ORDER BY last_modified_time DESC LIMIT 10;"
        else
            echo "(no conversation history database found)"
        fi
        ;;

    -*)
        # Flags passed without an explicit profile name (e.g. mgy --conversation=<id>, mgy -c)
        if [ -n "$MULTIGRAVITY_DEFAULT_PROFILE" ] && [ -d "$PROFILES_DIR/$MULTIGRAVITY_DEFAULT_PROFILE" ]; then
            SELECTED_PROFILE="$MULTIGRAVITY_DEFAULT_PROFILE"
        else
            mapfile -t avail_profiles < <(ls -1 "$PROFILES_DIR" 2>/dev/null || true)
            if [ "${#avail_profiles[@]}" -eq 1 ] && [ -n "${avail_profiles[0]}" ]; then
                SELECTED_PROFILE="${avail_profiles[0]}"
            elif [ "${#avail_profiles[@]}" -eq 0 ]; then
                echo "Error: No profiles found. Create one first using: $CMD_NAME new <profile_name>"
                exit 1
            else
                echo "Multiple profiles found. Please specify which profile to run: $CMD_NAME <profile> $*"
                echo "Available profiles:"
                for p in "${avail_profiles[@]}"; do
                    echo "  • $p"
                done
                exit 1
            fi
        fi
        TARGET_DIR="$PROFILES_DIR/$SELECTED_PROFILE"
        setup_profile_environment "$TARGET_DIR"
        echo "Starting agy with profile '$SELECTED_PROFILE'..."
        USERPROFILE="$TARGET_DIR" HOME="$TARGET_DIR" exec agy "$@"
        ;;

    *)
        TARGET_DIR="$PROFILES_DIR/$1"
        if [ ! -d "$TARGET_DIR" ]; then
            echo "Error: profile '$1' does not exist. Create it first using: $CMD_NAME new $1"
            exit 1
        fi
        setup_profile_environment "$TARGET_DIR"
        echo "Starting agy with profile '$1'..."
        USERPROFILE="$TARGET_DIR" HOME="$TARGET_DIR" exec agy "${@:2}"
        ;;
esac
