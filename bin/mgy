#!/usr/bin/env bash

# mgy (multigravity) - Profile manager for Antigravity CLI (agy)
# Manages isolated credentials, sessions, and configurations per profile.

CMD_NAME="$(basename "$0")"
[ "$CMD_NAME" != "multigravity" ] && CMD_NAME="mgy"

if [[ "$HOME" == *"/.config/multigravity-profiles"* ]]; then
    REAL_HOME="${REAL_HOME:-${HOME%%/.config/multigravity-profiles*}}"
else
    REAL_HOME="${REAL_HOME:-$HOME}"
fi
PROFILES_DIR="${MULTIGRAVITY_PROFILES_DIR:-$REAL_HOME/.config/multigravity-profiles}"

print_help() {
    cat << EOF
Usage: $CMD_NAME [command] [options]

Commands:
  auto [agy args]        Autonomous mode: auto-selects profile, kills on 429 quota exhaustion, & resumes
  best [agy args]        Starts agy on the profile with highest available quota (no auto-switching)
  resume [id] [agy args] Rebind trajectory_meta and resume conversation on best profile
  new <profile>          Create a new isolated profile and authenticate
  import <profile|tar.gz> Import host session into profile OR import conversation archive
  list                   List all existing profiles
  quotas, quota, quotes Check Gemini 3.8+ quota usage across all profiles (-a for all)
  conversations          List recent conversations and their IDs
  fork --conversation=<id> Fork an existing conversation across all other profiles
  export <conv_id> [tar] Export a conversation into a portable tar.gz archive
  import-conversation <tar> Alias for import conversation archive
  delete <profile>       Delete an existing profile
  help, --help, -h       Show this help message
  <profile> [agy args]   Start agy session using the specified profile

Resume & Conversation Flags:
  $CMD_NAME auto                            Start session with dynamic quota switching & auto-resume
  $CMD_NAME auto --continue                 Continue latest conversation with dynamic quota switching
  $CMD_NAME best                            Start session on the best profile without auto-switching
  $CMD_NAME resume [conv_id]                Resume latest (or specified) conversation on best profile
  $CMD_NAME <profile> -c, --conversation=<id> Resume a specific conversation by ID (auto-rebinds trajectory)
  $CMD_NAME <profile> --continue            Continue the most recent conversation (auto-rebinds trajectory)

Examples:
  $CMD_NAME auto                          # Dynamic quota switching: auto-kills on 429 and resumes next best account
  $CMD_NAME auto --continue               # Continue latest chat with dynamic auto-failover
  $CMD_NAME best                          # Pick profile with highest quota and run agy normally
  $CMD_NAME resume <id>                   # Rebind SQLite trajectory and resume chat on best profile
  $CMD_NAME new <profile>                 # Set up a new profile with Google login
  $CMD_NAME list                          # List all registered profiles
  $CMD_NAME fork -c <id>                  # Fork conversation across all profiles
  $CMD_NAME export <id> [path.tar.gz]     # Export conversation to a portable archive
  $CMD_NAME import <path.tar.gz>          # Import conversation archive into agy
  $CMD_NAME import-conversation <archive> # (Alias) Import conversation archive
  $CMD_NAME <profile>                     # Start interactive agy session with profile
  $CMD_NAME <profile> --continue          # Continue latest chat under profile
  $CMD_NAME <profile> -c <id>             # Resume specific conversation by ID (-c is alias for --conversation)
  $CMD_NAME conversations                 # View list of recent conversation IDs
  $CMD_NAME quotas                        # Inspect Gemini 3.8+ quotas across all profiles
  $CMD_NAME quotas -a                     # Inspect all models (including Claude and OpenAI)
EOF
}

usage() {
    print_help
    exit 1
}

ORIG_DEFAULT_KC=""
ORIG_USER_KCS=""
CURRENT_ACTIVE_TARGET=""

get_profile_token_account() {
    local raw="$1"
    [ -z "$raw" ] && return 1

    local python_bin=""
    if command -v python3 >/dev/null 2>&1; then
        python_bin="python3"
    elif command -v python >/dev/null 2>&1; then
        python_bin="python"
    fi

    if [ -n "$python_bin" ]; then
        "$python_bin" - "$raw" 2>/dev/null <<'EOF'
import sys, json, base64

raw = sys.argv[1].strip().lstrip("\ufeff")
if raw.startswith("go-keyring-base64:"):
    raw = base64.b64decode(raw.split(":", 1)[1]).decode("utf-8-sig", errors="ignore")

try:
    payload = json.loads(raw)
    if isinstance(payload, dict):
        email = payload.get("id_token_email") or payload.get("email")
        tok = payload.get("token") if isinstance(payload.get("token"), dict) else payload
        if not email and isinstance(tok, dict):
            email = tok.get("id_token_email") or tok.get("email")
        id_token = payload.get("id_token") or (tok.get("id_token") if isinstance(tok, dict) else None)
        if not email and id_token and "." in id_token:
            parts = id_token.split(".")
            if len(parts) > 1:
                padded = parts[1] + "=" * ((4 - len(parts[1]) % 4) % 4)
                claims = json.loads(base64.urlsafe_b64decode(padded))
                email = claims.get("email") or claims.get("sub")
        if email:
            print(email)
            sys.exit(0)
        if isinstance(tok, dict) and tok.get("refresh_token"):
            print(tok.get("refresh_token"))
            sys.exit(0)
except Exception:
    pass
sys.exit(1)
EOF
    else
        local mail=""
        if [[ "$raw" == go-keyring-base64:* ]]; then
            raw=$(echo "${raw#go-keyring-base64:}" | base64 -d 2>/dev/null || true)
        fi
        mail=$(echo "$raw" | grep -o '"id_token_email"[[:space:]]*:[[:space:]]*"[^"]*"' | sed -E 's/.*"id_token_email"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' || true)
        [ -z "$mail" ] && mail=$(echo "$raw" | grep -o '"email"[[:space:]]*:[[:space:]]*"[^"]*"' | sed -E 's/.*"email"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' || true)
        if [ -n "$mail" ]; then
            echo "$mail"
            return 0
        fi
        return 1
    fi
}

trap_profile_cleanup() {
    if [ -n "$CURRENT_ACTIVE_TARGET" ]; then
        restore_profile_keychain "$CURRENT_ACTIVE_TARGET"
    fi
}

trap trap_profile_cleanup EXIT INT TERM HUP

activate_profile_keychain() {
    local target="$1"
    [ -z "$target" ] && return 0

    local token_file="$target/.tokens/credential.txt"
    mkdir -p "$target/.tokens"
    mkdir -p "$target/.gemini/antigravity-cli"

    # Sync profile token file directly into profile's isolated directory
    # NEVER write to $REAL_HOME/.gemini/antigravity-cli to avoid clobbering other profiles.
    if [ -f "$token_file" ]; then
        cp "$token_file" "$target/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true
        cp "$token_file" "$target/antigravity-oauth-token" 2>/dev/null || true
        chmod 600 "$target/.gemini/antigravity-cli/antigravity-oauth-token" "$target/antigravity-oauth-token" 2>/dev/null || true
    fi

    if [[ "$OSTYPE" == "darwin"* ]]; then
        local kc="$target/Library/Keychains/login.keychain-db"
        if [ -f "$kc" ]; then
            if [ -z "$ORIG_DEFAULT_KC" ]; then
                ORIG_DEFAULT_KC="$(security default-keychain 2>/dev/null | tr -d '\" ' | xargs)"
                ORIG_USER_KCS="$(security list-keychains -d user 2>/dev/null | tr -d '\"' | xargs)"
                if [[ "$ORIG_DEFAULT_KC" == *"multigravity-profiles"* ]] || [ ! -f "$ORIG_DEFAULT_KC" ]; then
                    ORIG_DEFAULT_KC="$REAL_HOME/Library/Keychains/login.keychain-db"
                fi
                if [[ "$ORIG_USER_KCS" == *"multigravity-profiles"* ]] || [ -z "$ORIG_USER_KCS" ]; then
                    ORIG_USER_KCS="$REAL_HOME/Library/Keychains/login.keychain-db"
                fi
            fi
            security default-keychain -s "$kc" 2>/dev/null || true
            security list-keychains -d user -s "$kc" 2>/dev/null || true
            security unlock-keychain -p "" "$kc" 2>/dev/null || true

            # If credential.txt exists and keychain does not have it yet, seed keychain
            if [ -f "$token_file" ]; then
                local current_kc_token
                current_kc_token="$(security find-generic-password -s gemini -a antigravity -w "$kc" 2>/dev/null || true)"
                if [ -z "$current_kc_token" ]; then
                    local tdata
                    tdata="$(cat "$token_file" 2>/dev/null || true)"
                    if [ -n "$tdata" ]; then
                        security add-generic-password -U -s gemini -a antigravity -w "$tdata" "$kc" 2>/dev/null || true
                    fi
                fi
            fi
        fi
    fi
}

restore_profile_keychain() {
    local target="$1"
    [ -z "$target" ] || [ ! -d "$target" ] && return 0

    local token_file="$target/.tokens/credential.txt"
    mkdir -p "$target/.tokens"

    local saved_raw=""

    if [[ "$OSTYPE" == "darwin"* ]]; then
        local kc="$target/Library/Keychains/login.keychain-db"
        if [ -f "$kc" ]; then
            saved_raw="$(security find-generic-password -s gemini -a antigravity -w "$kc" 2>/dev/null || true)"
        fi
        local host_kc="$REAL_HOME/Library/Keychains/login.keychain-db"
        local target_def="${ORIG_DEFAULT_KC:-$host_kc}"
        if [[ "$target_def" == *"multigravity-profiles"* ]] || [ ! -f "$target_def" ]; then
            target_def="$host_kc"
        fi
        security default-keychain -s "$target_def" 2>/dev/null || true
        local target_list="${ORIG_USER_KCS:-$host_kc}"
        if [[ "$target_list" == *"multigravity-profiles"* ]]; then
            target_list="$host_kc"
        fi
        security list-keychains -d user -s $target_list 2>/dev/null || true
    fi

    # Check file token locations if keychain was empty or on Linux
    if [ -z "$saved_raw" ]; then
        local saved_source=""
        if [ -f "$target/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
            saved_source="$target/.gemini/antigravity-cli/antigravity-oauth-token"
        elif [ -f "$target/antigravity-oauth-token" ]; then
            saved_source="$target/antigravity-oauth-token"
        fi
        if [ -n "$saved_source" ] && [ -f "$saved_source" ]; then
            saved_raw="$(cat "$saved_source" 2>/dev/null || true)"
        fi
    fi

    if [ -n "$saved_raw" ]; then
        local initial_raw=""
        [ -f "$token_file" ] && initial_raw="$(cat "$token_file" 2>/dev/null || true)"

        local saved_account="" initial_account=""
        saved_account="$(get_profile_token_account "$saved_raw" 2>/dev/null || true)"
        initial_account="$(get_profile_token_account "$initial_raw" 2>/dev/null || true)"

        local should_save=0
        if [ -z "$initial_raw" ] || [ ! -f "$token_file" ]; then
            should_save=1
        elif [ -n "$initial_account" ] && [ -n "$saved_account" ] && [ "$initial_account" = "$saved_account" ]; then
            should_save=1
        elif [ -z "$initial_account" ] && [ -z "$saved_account" ]; then
            should_save=1
        else
            local prof_name
            prof_name="$(basename "$target")"
            echo "[!] mgy: Skipped saving credential for '$prof_name' ($initial_account) because active session holds a different account ($saved_account)." >&2
        fi

        if [ "$should_save" -eq 1 ]; then
            printf "%s" "$saved_raw" > "$token_file" 2>/dev/null || true
            chmod 600 "$token_file" 2>/dev/null || true
            # Keep isolated file token in sync
            printf "%s" "$saved_raw" > "$target/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true
            printf "%s" "$saved_raw" > "$target/antigravity-oauth-token" 2>/dev/null || true
            chmod 600 "$target/.gemini/antigravity-cli/antigravity-oauth-token" "$target/antigravity-oauth-token" 2>/dev/null || true
        fi
    fi
}

setup_profile_environment() {
    local target="$1"
    [ -z "$target" ] && return 0

    mkdir -p "$target/.gemini"

    # Keep .gemini/antigravity-cli as a real directory per profile on both Linux and macOS
    # so antigravity-oauth-token is isolated to this profile, while symlinking all shared
    # resources (conversations, history, summaries, MCP settings, plugins, etc.)
    if [ -L "$target/.gemini/antigravity-cli" ]; then
        local tmp_cli="$target/.gemini/antigravity-cli.tmp.$$"
        rm -rf "$tmp_cli" 2>/dev/null || true
        mkdir -p "$tmp_cli"
        if [ -d "$REAL_HOME/.gemini/antigravity-cli" ]; then
            for item in "$REAL_HOME/.gemini/antigravity-cli"/* "$REAL_HOME/.gemini/antigravity-cli"/.*; do
                [ -e "$item" ] || continue
                local base
                base="$(basename "$item")"
                case "$base" in
                    .|..|antigravity-oauth-token*|.tokens*|cli.log*)
                        continue
                        ;;
                    *)
                        ln -sf "$item" "$tmp_cli/$base"
                        ;;
                esac
            done
        fi
        # Seed profile token if present
        local token_file="$target/.tokens/credential.txt"
        if [ -f "$token_file" ]; then
            cp "$token_file" "$tmp_cli/antigravity-oauth-token" 2>/dev/null || true
            chmod 600 "$tmp_cli/antigravity-oauth-token" 2>/dev/null || true
        fi
        rm -f "$target/.gemini/antigravity-cli"
        mv "$tmp_cli" "$target/.gemini/antigravity-cli"
    else
        mkdir -p "$target/.gemini/antigravity-cli"
        if [ -d "$REAL_HOME/.gemini/antigravity-cli" ]; then
            for item in "$REAL_HOME/.gemini/antigravity-cli"/* "$REAL_HOME/.gemini/antigravity-cli"/.*; do
                [ -e "$item" ] || continue
                local base
                base="$(basename "$item")"
                case "$base" in
                    .|..|antigravity-oauth-token*|.tokens*|cli.log*)
                        continue
                        ;;
                    *)
                        if [ ! -e "$target/.gemini/antigravity-cli/$base" ] && [ ! -L "$target/.gemini/antigravity-cli/$base" ]; then
                            ln -sf "$item" "$target/.gemini/antigravity-cli/$base"
                        fi
                        ;;
                esac
            done
        fi
    fi

    # Remove broken symlinks in profile's antigravity-cli
    for sub in "$target/.gemini/antigravity-cli"/* "$target/.gemini/antigravity-cli"/.*; do
        [ -L "$sub" ] && [ ! -e "$sub" ] && rm -f "$sub"
    done

    # Ensure profile token is copied to both antigravity-oauth-token locations
    local token_file="$target/.tokens/credential.txt"
    if [ -f "$token_file" ]; then
        if [ ! -f "$target/.gemini/antigravity-cli/antigravity-oauth-token" ] || [ "$token_file" -nt "$target/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
            cp "$token_file" "$target/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true
            chmod 600 "$target/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true
        fi
        if [ ! -f "$target/antigravity-oauth-token" ] || [ "$token_file" -nt "$target/antigravity-oauth-token" ]; then
            cp "$token_file" "$target/antigravity-oauth-token" 2>/dev/null || true
            chmod 600 "$target/antigravity-oauth-token" 2>/dev/null || true
        fi
    elif [ -f "$target/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
        mkdir -p "$target/.tokens"
        cp "$target/.gemini/antigravity-cli/antigravity-oauth-token" "$token_file" 2>/dev/null || true
        chmod 600 "$token_file" 2>/dev/null || true
    elif [ -f "$target/antigravity-oauth-token" ]; then
        mkdir -p "$target/.tokens"
        cp "$target/antigravity-oauth-token" "$token_file" 2>/dev/null || true
        chmod 600 "$token_file" 2>/dev/null || true
    fi

    # Preserve git author info and SSH keys if present in user's home
    if [ -f "$REAL_HOME/.gitconfig" ] && [ ! -e "$target/.gitconfig" ]; then
        ln -sf "$REAL_HOME/.gitconfig" "$target/.gitconfig"
    fi
    if [ -d "$REAL_HOME/.ssh" ] && [ ! -e "$target/.ssh" ]; then
        ln -sf "$REAL_HOME/.ssh" "$target/.ssh"
    fi

    # macOS Keychain isolation support (keeps OAuth tokens isolated per account)
    if [[ "$OSTYPE" == "darwin"* ]]; then
        local kc="$target/Library/Keychains/login.keychain-db"
        if [ ! -L "$target/Library/Keychains" ] && [ ! -L "$kc" ]; then
            mkdir -p "$target/Library/Keychains"
            if [ ! -e "$kc" ]; then
                security create-keychain -p "" "$kc" 2>/dev/null || true
            fi
            if [ -f "$kc" ]; then
                security set-keychain-settings "$kc" 2>/dev/null || true
                security unlock-keychain -p "" "$kc" 2>/dev/null || true
            fi
        fi
    fi
}

is_profile_authenticated() {
    local target="$1"
    if [[ "$OSTYPE" == "darwin"* ]]; then
        local kc="$target/Library/Keychains/login.keychain-db"
        if [ -f "$kc" ]; then
            if security find-generic-password -s gemini -a antigravity "$kc" >/dev/null 2>&1; then
                return 0
            fi
        fi
    fi
    if [ -f "$target/.tokens/credential.txt" ]; then
        return 0
    elif [ -f "$target/antigravity-oauth-token" ] || [ -f "$target/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
        return 0
    else
        return 1
    fi
}

migrate_profiles_if_needed() {
    [ -d "$PROFILES_DIR" ] || return 0

    for prof_path in "$PROFILES_DIR"/*; do
        [ -d "$prof_path" ] || continue
        local bname
        bname="$(basename "$prof_path")"
        [[ "$bname" == .* ]] && continue

        if [ -L "$prof_path/.gemini/antigravity-cli" ]; then
            setup_profile_environment "$prof_path"
        fi
    done
}

list_profiles() {
    local target_dir="${1:-$PROFILES_DIR}"
    if [ ! -d "$target_dir" ] || [ -z "$(ls -A "$target_dir" 2>/dev/null)" ]; then
        echo "  (no profiles found)"
        return 0
    fi

    local python_bin=""
    if command -v python3 >/dev/null 2>&1; then
        python_bin="python3"
    elif command -v python >/dev/null 2>&1; then
        python_bin="python"
    fi

    if [ -n "$python_bin" ]; then
        local py_target="$target_dir"
        local py_home="$REAL_HOME"
        if command -v cygpath >/dev/null 2>&1; then
            py_target=$(cygpath -m "$target_dir")
            py_home=$(cygpath -m "$REAL_HOME")
        fi

        local py_output
        py_output=$("$python_bin" - "$py_target" "$py_home" 2>/dev/null <<'EOF'
import os, sys, json, base64, subprocess

profiles_dir = sys.argv[1]
real_home = sys.argv[2]

if not os.path.exists(profiles_dir):
    print("  (no profiles found)")
    sys.exit(0)

entries = [d for d in sorted(os.listdir(profiles_dir)) if os.path.isdir(os.path.join(profiles_dir, d)) and not d.startswith(".")]

if not entries:
    print("  (no profiles found)")
    sys.exit(0)

results = []
for name in entries:
    p = os.path.join(profiles_dir, name)
    email = None
    raw = None

    # 1. macOS Keychain
    if sys.platform == "darwin":
        kc = os.path.join(p, "Library", "Keychains", "login.keychain-db")
        if os.path.exists(kc):
            try:
                subprocess.run(["security", "unlock-keychain", "-p", "", kc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                raw = subprocess.check_output(["security", "find-generic-password", "-s", "gemini", "-a", "antigravity", "-w", kc], stderr=subprocess.DEVNULL).decode().strip()
            except Exception:
                pass

    # 2. Token files
    if not raw:
        for fname in [
            os.path.join(p, ".tokens", "credential.txt"),
            os.path.join(p, ".tokens", "token.json"),
            os.path.join(p, "antigravity-oauth-token"),
            os.path.join(p, ".gemini", "antigravity-cli", "antigravity-oauth-token"),
        ]:
            if os.path.exists(fname):
                try:
                    with open(fname, "r", encoding="utf-8-sig") as f:
                        raw = f.read().strip()
                        if raw:
                            break
                except Exception:
                    pass

    # 3. Decode email
    if raw:
        try:
            raw = raw.strip().lstrip("\ufeff")
            if raw.startswith("go-keyring-base64:"):
                raw = base64.b64decode(raw.split(":", 1)[1]).decode("utf-8-sig", errors="ignore")
            payload = json.loads(raw)
            if isinstance(payload, dict):
                email = payload.get("id_token_email") or payload.get("email")
                tok = payload.get("token") if isinstance(payload.get("token"), dict) else payload
                if not email and isinstance(tok, dict):
                    email = tok.get("id_token_email") or tok.get("email")
                id_token = payload.get("id_token") or (tok.get("id_token") if isinstance(tok, dict) else None)
                if not email and id_token and "." in id_token:
                    parts = id_token.split(".")
                    if len(parts) > 1:
                        padded = parts[1] + "=" * ((4 - len(parts[1]) % 4) % 4)
                        claims = json.loads(base64.urlsafe_b64decode(padded))
                        email = claims.get("email") or claims.get("sub")
        except Exception:
            pass

    results.append((name, email))

max_len = max(len(n) for n, _ in results) if results else 0
for name, email in results:
    if email:
        print(f"  • {name:<{max_len}}  ({email})")
    else:
        print(f"  • {name:<{max_len}}  (not authenticated)")
EOF
        )
        if [ $? -eq 0 ] && [ -n "$py_output" ]; then
            echo "$py_output"
            return 0
        fi
    fi

    # Fallback if python is not available
    for p in "$target_dir"/*; do
        [ -d "$p" ] || continue
        name="$(basename "$p")"
        [[ "$name" == .* ]] && continue
        local mail=""
        for cf in "$p/.tokens/credential.txt" "$p/.tokens/token.json" "$p/antigravity-oauth-token" "$p/.gemini/antigravity-cli/antigravity-oauth-token"; do
            if [ -f "$cf" ]; then
                local raw=""
                raw=$(cat "$cf" 2>/dev/null)
                if [[ "$raw" == go-keyring-base64:* ]]; then
                    raw=$(echo "${raw#go-keyring-base64:}" | base64 -d 2>/dev/null || true)
                fi
                mail=$(echo "$raw" | grep -o '"id_token_email"[[:space:]]*:[[:space:]]*"[^"]*"' | sed -E 's/.*"id_token_email"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' || true)
                [ -z "$mail" ] && mail=$(echo "$raw" | grep -o '"email"[[:space:]]*:[[:space:]]*"[^"]*"' | sed -E 's/.*"email"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' || true)
                [ -n "$mail" ] && break
            fi
        done
        if [ -n "$mail" ]; then
            echo "  • $name  ($mail)"
        elif is_profile_authenticated "$p"; then
            echo "  • $name"
        else
            echo "  • $name  (not authenticated)"
        fi
    done
}

export_conversation_handler() {
    local conv_id=""
    local output_tar=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                echo "Usage: $CMD_NAME export <conversation_id> [tar_gz_path]"
                echo "Exports an Antigravity conversation and its artifacts to a portable tar.gz archive."
                exit 0
                ;;
            --conversation=*|-c=*)
                conv_id="${1#*=}"
                shift
                ;;
            --conversation|-c)
                conv_id="$2"
                shift 2
                ;;
            *)
                if [ -z "$conv_id" ]; then
                    conv_id="$1"
                elif [ -z "$output_tar" ]; then
                    output_tar="$1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$conv_id" ]; then
        echo "Error: Missing conversation ID to export."
        echo "Usage: $CMD_NAME export <conversation_id> [tar_gz_path]"
        exit 1
    fi

    local source_dir="$REAL_HOME/.gemini/antigravity-cli"
    local src_db="$source_dir/conversations/$conv_id.db"
    local src_brain="$source_dir/brain/$conv_id"
    local src_anno="$source_dir/annotations/$conv_id.pbtxt"

    if [ ! -f "$src_db" ] && [ ! -d "$src_brain" ]; then
        echo "Error: Conversation '$conv_id' not found at $source_dir"
        exit 1
    fi

    if [ -z "$output_tar" ]; then
        output_tar="conversation_${conv_id}.tar.gz"
    fi

    local orig_pwd="$(pwd)"
    local abs_output_tar=""
    if [[ "$output_tar" != /* ]]; then
        abs_output_tar="$orig_pwd/$output_tar"
    else
        abs_output_tar="$output_tar"
    fi

    if [ -d "$abs_output_tar" ]; then
        abs_output_tar="$abs_output_tar/conversation_${conv_id}.tar.gz"
    fi

    mkdir -p "$(dirname "$abs_output_tar")"

    # Flush SQLite WAL to ensure main .db contains full state
    if command -v sqlite3 >/dev/null 2>&1 && [ -f "$src_db" ]; then
        sqlite3 "$src_db" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
    fi

    # Export conversation summary metadata if python is available
    local python_bin=""
    if command -v python3 >/dev/null 2>&1; then
        python_bin="python3"
    elif command -v python >/dev/null 2>&1; then
        python_bin="python"
    fi

    if [ -n "$python_bin" ] && [ -d "$src_brain" ]; then
        "$python_bin" - <<EOF 2>/dev/null || true
import sqlite3, json, os

conv_id = '$conv_id'
sum_db = os.path.expanduser('$source_dir/conversation_summaries.db')
brain_dir = os.path.expanduser('$src_brain')

if os.path.exists(sum_db) and os.path.isdir(brain_dir):
    try:
        conn = sqlite3.connect(sum_db, timeout=5.0)
        cur = conn.cursor()
        cur.execute("SELECT * FROM conversation_summaries WHERE conversation_id = ?", (conv_id,))
        row = cur.fetchone()
        if row:
            cols = [col[0] for col in cur.description]
            data = {}
            for c, v in zip(cols, row):
                if isinstance(v, bytes):
                    data[c] = {"__bytes__": v.hex()}
                else:
                    data[c] = v
            with open(os.path.join(brain_dir, '.conversation_summary.json'), 'w') as f:
                json.dump(data, f)
        conn.close()
    except Exception:
        pass
EOF
    fi

    # Build relative file list for clean extraction
    local items=()
    [ -f "$source_dir/conversations/$conv_id.db" ] && items+=("conversations/$conv_id.db")
    [ -f "$source_dir/conversations/$conv_id.db-wal" ] && items+=("conversations/$conv_id.db-wal")
    [ -f "$source_dir/conversations/$conv_id.db-shm" ] && items+=("conversations/$conv_id.db-shm")
    [ -f "$src_anno" ] && items+=("annotations/$conv_id.pbtxt")
    [ -d "$src_brain" ] && items+=("brain/$conv_id")

    echo "Exporting conversation '$conv_id'..."
    if tar -czf "$abs_output_tar" -C "$source_dir" "${items[@]}"; then
        local size=$(du -h "$abs_output_tar" 2>/dev/null | awk '{print $1}')
        echo "==> Successfully exported conversation archive ($size)"
        echo "Archive: $abs_output_tar"
        echo ""
        echo "To import and resume on another machine:"
        echo "  $CMD_NAME import $abs_output_tar"
        echo "Or manually:"
        echo "  mkdir -p ~/.gemini/antigravity-cli"
        echo "  tar -xzf $abs_output_tar -C ~/.gemini/antigravity-cli/"
        echo "  agy --conversation $conv_id"
    else
        echo "Error: Failed to create tar archive."
        exit 1
    fi
}

import_conversation_handler() {
    if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        echo "Usage: $CMD_NAME import <path_to_tar_gz>"
        echo "Imports an exported Antigravity conversation archive into ~/.gemini/antigravity-cli."
        exit 0
    fi
    local archive_path="$1"
    if [ -z "$archive_path" ]; then
        echo "Error: Missing archive path."
        echo "Usage: $CMD_NAME import <path_to_tar_gz>"
        exit 1
    fi

    local orig_pwd="$(pwd)"
    local abs_archive=""
    if [[ "$archive_path" != /* ]]; then
        abs_archive="$orig_pwd/$archive_path"
    else
        abs_archive="$archive_path"
    fi

    if [ ! -f "$abs_archive" ]; then
        echo "Error: Archive file not found: $abs_archive"
        exit 1
    fi

    local target_dir="$REAL_HOME/.gemini/antigravity-cli"
    mkdir -p "$target_dir"
    mkdir -p "$target_dir/conversations"
    mkdir -p "$target_dir/brain"
    mkdir -p "$target_dir/annotations"

    echo "Importing conversation archive: $abs_archive..."
    local extracted=0
    local imported_id=""

    # Extract using tar (handles .tar.gz and .tgz across macOS, Linux, and Windows)
    if tar -xzf "$abs_archive" -C "$target_dir" 2>/dev/null; then
        extracted=1
        imported_id=$(tar -tf "$abs_archive" 2>/dev/null | grep -E 'conversations/[a-zA-Z0-9-]+\.db$' | head -n 1 | sed -E 's|.*conversations/([^/]+)\.db|\1|')
    elif command -v unzip >/dev/null 2>&1 && unzip -qo "$abs_archive" -d "$target_dir" 2>/dev/null; then
        extracted=1
        imported_id=$(unzip -l "$abs_archive" 2>/dev/null | grep -E 'conversations/[a-zA-Z0-9-]+\.db$' | head -n 1 | sed -E 's|.*conversations/([^/]+)\.db|\1|')
    fi

    if [ "$extracted" -ne 1 ]; then
        echo "Error: Failed to extract archive."
        exit 1
    fi

    echo "==> Successfully extracted conversation files to $target_dir"

    # Restore summary row if python is available
    local python_bin=""
    if command -v python3 >/dev/null 2>&1; then
        python_bin="python3"
    elif command -v python >/dev/null 2>&1; then
        python_bin="python"
    fi

    if [ -n "$python_bin" ] && [ -n "$imported_id" ]; then
        local py_target="$target_dir"
        if command -v cygpath >/dev/null 2>&1; then
            py_target=$(cygpath -m "$target_dir")
        fi
        "$python_bin" - <<EOF 2>/dev/null || true
import sqlite3, json, os

conv_id = '$imported_id'
target_dir = os.path.expanduser(r'$py_target')
sum_db = os.path.join(target_dir, 'conversation_summaries.db')
meta_file = os.path.join(target_dir, 'brain', conv_id, '.conversation_summary.json')

if os.path.exists(sum_db) and os.path.exists(meta_file):
    try:
        with open(meta_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
        conn = sqlite3.connect(sum_db, timeout=5.0)
        cur = conn.cursor()
        cols = []
        vals = []
        for k, v in data.items():
            cols.append(k)
            if isinstance(v, dict) and "__bytes__" in v:
                vals.append(bytes.fromhex(v["__bytes__"]))
            else:
                vals.append(v)
        placeholders = ",".join(["?"] * len(cols))
        sql = f"INSERT OR REPLACE INTO conversation_summaries ({','.join(cols)}) VALUES ({placeholders})"
        cur.execute(sql, vals)
        conn.commit()
        conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
        conn.close()
    except Exception:
        pass
EOF
    fi

    if [ -n "$imported_id" ]; then
        echo "Imported conversation ID: $imported_id"
        echo ""
        echo "You can resume it using:"
        echo "  $CMD_NAME <profile> --conversation $imported_id"
        echo "  agy --conversation $imported_id"
    fi
}

resolve_quota_bin() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -x "$script_dir/mgy-quota" ]; then
        echo "$script_dir/mgy-quota"
    elif command -v mgy-quota >/dev/null 2>&1; then
        command -v mgy-quota
    elif [ -f "$script_dir/mgy-quota" ]; then
        echo "$script_dir/mgy-quota"
    fi
}

get_model_hint_from_args() {
    local prev=""
    for arg in "$@"; do
        if [ "$prev" = "--model" ]; then
            echo "$arg"
            return 0
        fi
        case "$arg" in
            --model=*)
                echo "${arg#--model=}"
                return 0
                ;;
            --model)
                prev="--model"
                ;;
        esac
    done
}

select_best_profile() {
    local exclude="$1"
    local model_hint="$2"
    local qbin
    qbin="$(resolve_quota_bin)"
    [ -z "$qbin" ] && return 1
    local args=("--best" "--best-format" "detail")
    [ -n "$exclude" ] && args+=("--exclude" "$exclude")
    [ -n "$model_hint" ] && args+=("--model" "$model_hint")
    "$qbin" "${args[@]}" 2>/dev/null
}

show_all_depleted_alert() {
    echo ""
    echo -e "\033[31m================================================================================\033[0m"
    echo -e "\033[1;31m                    [!] ALL PROFILES DEPLETED [!]\033[0m"
    echo -e "\033[31m  Every authenticated profile has exhausted its Google Gemini quota.\033[0m"
    echo -e "\033[33m  No accounts are currently available to continue execution.\033[0m"
    echo -e "\033[31m================================================================================\033[0m"
    echo -e "\033[90mRun '$CMD_NAME quotas' to check countdown reset timers across all profiles.\033[0m\n"
    if command -v osascript >/dev/null 2>&1; then
        osascript -e 'display alert "Multigravity - All Quotas Depleted" message "Every authenticated profile has exhausted its Google Gemini quota.\n\nRun mgy quotas to inspect countdown reset timers."' >/dev/null 2>&1 &
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "Multigravity" "All Gemini quotas depleted across all profiles." >/dev/null 2>&1 &
    fi
}

start_profile_session() {
    local current_profile="$1"
    local auto_failover="${2:-0}"
    shift 2
    local current_args=("$@")

    local enable_failover=0
    if [ "$auto_failover" = "1" ] || [ "${MULTIGRAVITY_AUTO_FAILOVER:-0}" = "1" ] || [ "${MULTIGRAVITY_AUTO_FAILOVER:-0}" = "true" ] || [ "${MULTIGRAVITY_AUTO_FAILOVER:-0}" = "TRUE" ]; then
        enable_failover=1
    fi

    local filtered_init=()
    for a in "${current_args[@]}"; do
        if [ "$a" = "--auto-failover" ]; then
            enable_failover=1
        elif [ "$a" = "--no-failover" ]; then
            enable_failover=0
        else
            case "$a" in
                --version|-v|--help|-h) enable_failover=0 ;;
            esac
            filtered_init+=("$a")
        fi
    done
    current_args=("${filtered_init[@]}")
    if [ "${MGY_NO_FAILOVER:-0}" = "1" ] || [ "${MULTIGRAVITY_AUTO_FAILOVER:-}" = "0" ] || [ "${MULTIGRAVITY_AUTO_FAILOVER:-}" = "false" ] || [ "${MULTIGRAVITY_AUTO_FAILOVER:-}" = "FALSE" ]; then
        enable_failover=0
    fi

    local tried_profiles="$current_profile"
    local qbin
    qbin="$(resolve_quota_bin)"

    while true; do
        local target_dir="$PROFILES_DIR/$current_profile"
        if [ ! -d "$target_dir" ]; then
            echo "Error: profile '$current_profile' does not exist. Create it first using: $CMD_NAME new $current_profile"
            exit 1
        fi

        setup_profile_environment "$target_dir"

        # Intercept /goal passed via -i, --prompt-interactive, -p, --print, or --prompt
        # agy cannot parse slash commands when passed via CLI flags; it only recognizes them at the interactive REPL prompt (>).
        # We strip the flag from agy args, copy the command to the clipboard, and inject it directly into the REPL buffer.
        local intercepted_goal=""
        if [ "${#current_args[@]}" -gt 0 ]; then
            local stripped_args=()
            local skip_next=0
            for ((idx=0; idx<${#current_args[@]}; idx++)); do
                local argItem="${current_args[idx]}"
                if [ "$skip_next" -eq 1 ]; then
                    skip_next=0
                    continue
                fi
                case "$argItem" in
                    -i|--prompt-interactive|-p|--print|--prompt)
                        local nextVal="${current_args[idx+1]}"
                        local trimmed="${nextVal#"${nextVal%%[![:space:]]*}"}"
                        if [[ "$trimmed" == "/goal"* ]]; then
                            intercepted_goal="$nextVal"
                            skip_next=1
                            continue
                        fi
                        stripped_args+=("$argItem")
                        ;;
                    -i=*|--prompt-interactive=*|-p=*|--print=*|--prompt=*)
                        local valPart="${argItem#*=}"
                        valPart="${valPart#\"}"
                        valPart="${valPart%\"}"
                        valPart="${valPart#\'}"
                        valPart="${valPart%\'}"
                        local trimmed="${valPart#"${valPart%%[![:space:]]*}"}"
                        if [[ "$trimmed" == "/goal"* ]]; then
                            intercepted_goal="$valPart"
                            continue
                        fi
                        stripped_args+=("$argItem")
                        ;;
                    *)
                        stripped_args+=("$argItem")
                        ;;
                esac
            done
            if [ -n "$intercepted_goal" ]; then
                current_args=("${stripped_args[@]}")
            fi
        fi

        # Detect and rebind SQLite trajectory_meta if resuming an existing conversation (-c / --conversation or --continue)
        local active_conv_id=""
        local needs_latest=0
        local normalized_args=()
        local skip_next_conv=0
        for ((idx=0; idx<${#current_args[@]}; idx++)); do
            if [ "$skip_next_conv" -eq 1 ]; then
                skip_next_conv=0
                continue
            fi
            local a="${current_args[idx]}"
            case "$a" in
                --conversation=*)
                    active_conv_id="${a#--conversation=}"
                    normalized_args+=("$a")
                    ;;
                -c=*)
                    active_conv_id="${a#-c=}"
                    normalized_args+=("--conversation=$active_conv_id")
                    ;;
                --conversation)
                    local next_a="${current_args[idx+1]}"
                    if [ -n "$next_a" ] && [[ "$next_a" != -* ]]; then
                        active_conv_id="$next_a"
                        normalized_args+=("--conversation" "$next_a")
                        skip_next_conv=1
                    else
                        normalized_args+=("$a")
                    fi
                    ;;
                -c)
                    local next_a="${current_args[idx+1]}"
                    if [ -n "$next_a" ] && [[ "$next_a" != -* ]]; then
                        active_conv_id="$next_a"
                        normalized_args+=("--conversation" "$next_a")
                        skip_next_conv=1
                    else
                        normalized_args+=("--conversation")
                    fi
                    ;;
                --continue)
                    needs_latest=1
                    normalized_args+=("$a")
                    ;;
                *)
                    normalized_args+=("$a")
                    ;;
            esac
        done
        current_args=("${normalized_args[@]}")

        if [ -n "$qbin" ]; then
            if [ -n "$active_conv_id" ]; then
                "$qbin" --rebind "$active_conv_id" >/dev/null 2>&1 || true
            elif [ "$needs_latest" -eq 1 ]; then
                local resolved_id
                resolved_id="$("$qbin" --rebind latest 2>/dev/null || true)"
                if [ -n "$resolved_id" ]; then
                    active_conv_id="$resolved_id"
                    local rewritten=()
                    local replaced=0
                    for a in "${current_args[@]}"; do
                        if [ "$replaced" -eq 0 ] && [ "$a" = "--continue" ]; then
                            rewritten+=("--conversation" "$active_conv_id")
                            replaced=1
                        else
                            rewritten+=("$a")
                        fi
                    done
                    current_args=("${rewritten[@]}")
                fi
            fi
        fi

        local session_start_epoch
        session_start_epoch="$(date +%s)"

        local sentinel_file="$PROFILES_DIR/.exhausted_$$"
        rm -f "$sentinel_file" 2>/dev/null || true
        local monitor_pid=""
        if [ "$enable_failover" = "1" ] && [ -n "$qbin" ]; then
            local mon_args=("$qbin" "--monitor-session" "--profile" "$current_profile" "--parent-pid" "$$" "--since" "$session_start_epoch")
            [ -n "$active_conv_id" ] && mon_args+=("--conv-id" "$active_conv_id")
            python3 "${mon_args[@]}" >/dev/null 2>&1 &
            monitor_pid=$!
        fi

        # Trigger REPL injection if /goal was passed via -i or -p
        if [ -n "$intercepted_goal" ] && [ -n "$qbin" ]; then
            echo "==> Detected '/goal' command passed via CLI flag."
            echo "    Redirecting directly into interactive REPL: '$intercepted_goal'"
            local b64_goal=""
            if command -v base64 >/dev/null 2>&1; then
                b64_goal="$(printf '%s' "$intercepted_goal" | base64 | tr -d '\r\n')"
            fi
            if [ -n "$b64_goal" ]; then
                python3 "$qbin" --inject-repl-b64 "$b64_goal" --delay 1.5 >/dev/null 2>&1 &
            else
                python3 "$qbin" --inject-repl "$intercepted_goal" --delay 1.5 >/dev/null 2>&1 &
            fi
        fi

        activate_profile_keychain "$target_dir"
        CURRENT_ACTIVE_TARGET="$target_dir"
        echo "Starting agy with profile '$current_profile'..."
        DBUS_SESSION_BUS_ADDRESS="" USERPROFILE="$target_dir" HOME="$target_dir" agy "${current_args[@]}"
        local status=$?
        restore_profile_keychain "$target_dir"
        CURRENT_ACTIVE_TARGET=""

        if [ -n "$monitor_pid" ]; then
            kill -9 "$monitor_pid" 2>/dev/null || true
            wait "$monitor_pid" 2>/dev/null || true
        fi

        # Inspect session outcome and record quota lockout if exhausted during this run
        if [ -n "$qbin" ]; then
            python3 "$qbin" --record-lockout "$current_profile" >/dev/null 2>&1 || true
        fi

        if [ "$enable_failover" = "1" ] && [ -n "$qbin" ]; then
            local is_exhausted=0
            local ex_pct="0.0"
            local ex_prov="Google Gemini"

            if [ -f "$sentinel_file" ]; then
                is_exhausted=1
                local sentinel_data
                sentinel_data="$(cat "$sentinel_file" 2>/dev/null || true)"
                if [ -n "$sentinel_data" ]; then
                    local s_conv
                    IFS='|' read -r s_conv _ <<< "$sentinel_data"
                    [ -n "$s_conv" ] && [ -z "$active_conv_id" ] && active_conv_id="$s_conv"
                fi
                rm -f "$sentinel_file" 2>/dev/null || true
            fi

            if [ -z "$active_conv_id" ]; then
                local found_conv
                found_conv="$("$qbin" --find-active-conv --since "$session_start_epoch" 2>/dev/null || true)"
                [ -n "$found_conv" ] && active_conv_id="$found_conv"
            fi

            local model_hint
            model_hint="$(get_model_hint_from_args "${current_args[@]}")"

            if [ "$is_exhausted" -eq 0 ] && [ -n "$active_conv_id" ]; then
                local chk_args=("--check-exhausted" "$current_profile" "--conv-id" "$active_conv_id")
                [ -n "$model_hint" ] && chk_args+=("--model" "$model_hint")
                local check_out
                if check_out="$("$qbin" "${chk_args[@]}" 2>/dev/null)" && [[ "$check_out" == EXHAUSTED\|* ]]; then
                    is_exhausted=1
                    IFS='|' read -r _ ex_pct ex_prov _ <<< "$check_out"
                fi
            fi

            if [ "$is_exhausted" -eq 1 ]; then
                echo ""
                echo "[!] Quota reached on profile '$current_profile' ($ex_prov: ${ex_pct}% remaining)."
                [ -n "$active_conv_id" ] && "$qbin" --rebind "$active_conv_id" >/dev/null 2>&1 || true

                local next_detail
                if next_detail="$(select_best_profile "$tried_profiles" "$model_hint")" && [ -n "$next_detail" ]; then
                    local next_prof next_tier next_pct _ next_prov
                    IFS='|' read -r next_prof next_tier next_pct _ next_prov <<< "$next_detail"
                    echo "==> Dynamic Account Switch: Resuming on '$next_prof' [$next_tier] ($next_prov: ${next_pct}% available)..."
                    if [ -n "$active_conv_id" ]; then
                        echo "==> Reopening conversation '$active_conv_id' with prompt:"
                        echo "    '/goal resume what you were doing before the quota depleted'"
                    else
                        echo "==> Starting fresh session on '$next_prof'..."
                    fi
                    current_profile="$next_prof"
                    tried_profiles="${tried_profiles},${current_profile}"

                    local is_print=0
                    local failover_args=()
                    local skip_next=0
                    for a in "${current_args[@]}"; do
                        if [ "$skip_next" -eq 1 ]; then
                            skip_next=0
                            continue
                        fi
                        case "$a" in
                            --conversation=*) ;;
                            --conversation) skip_next=1 ;;
                            -c|--continue) ;;
                            -i|--prompt-interactive) skip_next=1 ;;
                            -p|--print|--prompt) is_print=1; skip_next=1 ;;
                            *) failover_args+=("$a") ;;
                        esac
                    done
                    if [ -n "$active_conv_id" ]; then
                        local resume_cmd="/goal resume what you were doing before the quota depleted"
                        if [ "$is_print" -eq 1 ]; then
                            current_args=("--conversation" "$active_conv_id" "-p" "$resume_cmd" "${failover_args[@]}")
                        else
                            # Interactive REPL: omit -i so agy enters prompt loop, and inject /goal in background
                            current_args=("--conversation" "$active_conv_id" "${failover_args[@]}")
                            local b64_resume=""
                            if command -v base64 >/dev/null 2>&1; then
                                b64_resume="$(printf '%s' "$resume_cmd" | base64 | tr -d '\r\n')"
                            fi
                            if [ -n "$b64_resume" ]; then
                                python3 "$qbin" --inject-repl-b64 "$b64_resume" --delay 1.5 >/dev/null 2>&1 &
                            else
                                python3 "$qbin" --inject-repl "$resume_cmd" --delay 1.5 >/dev/null 2>&1 &
                            fi
                        fi
                    else
                        current_args=("${failover_args[@]}")
                    fi
                    continue
                else
                    show_all_depleted_alert
                    exit 1
                fi
            fi
        fi

        return $status
    done
}

migrate_profiles_if_needed

case "$1" in
    new)
        shift
        PROFILE_NAME="$1"
        [ -z "$PROFILE_NAME" ] && usage
        TARGET_DIR="$PROFILES_DIR/$PROFILE_NAME"

        if [ -d "$TARGET_DIR" ]; then
            echo "Profile '$PROFILE_NAME' already exists at: $TARGET_DIR"
            printf "Re-authenticate profile '%s'? [y/N]: " "$PROFILE_NAME"
            read -r resp
            case "$resp" in
                [yY][eE][sS]|[yY]) ;;
                *) echo "Aborted."; exit 0 ;;
            esac
        fi

        mkdir -p "$TARGET_DIR/.tokens"
        setup_profile_environment "$TARGET_DIR"
        # If re-authenticating, remove old tokens so agy prompts for fresh Google OAuth login
        rm -f "$TARGET_DIR/.gemini/antigravity-cli/antigravity-oauth-token" "$TARGET_DIR/antigravity-oauth-token" "$TARGET_DIR/.tokens/credential.txt" 2>/dev/null || true
        if [[ "$OSTYPE" == "darwin"* ]]; then
            local kc="$TARGET_DIR/Library/Keychains/login.keychain-db"
            if [ -f "$kc" ]; then
                security delete-generic-password -s gemini -a antigravity "$kc" >/dev/null 2>&1 || true
            fi
        fi
        activate_profile_keychain "$TARGET_DIR"

        CURRENT_ACTIVE_TARGET="$TARGET_DIR"
        echo "Setting up profile '$PROFILE_NAME'..."
        # Launch agy in interactive mode to authenticate without the 60s headless timeout
        DBUS_SESSION_BUS_ADDRESS="" USERPROFILE="$TARGET_DIR" HOME="$TARGET_DIR" agy
        status=$?
        restore_profile_keychain "$TARGET_DIR"
        CURRENT_ACTIVE_TARGET=""

        if is_profile_authenticated "$TARGET_DIR"; then
            echo "Profile '$PROFILE_NAME' is ready!"
        else
            echo "Profile '$PROFILE_NAME' was created, but not yet authenticated."
            echo "Run 'mgy $PROFILE_NAME' whenever you're ready to sign in."
        fi
        ;;

    import)
        shift
        arg="$1"
        [ -z "$arg" ] && usage

        # If argument looks like an archive (.tar.gz, .tgz, .tar, .zip) or is an existing file
        if [[ "$arg" == *.tar.gz ]] || [[ "$arg" == *.tgz ]] || [[ "$arg" == *.tar ]] || [[ "$arg" == *.zip ]] || [ -f "$arg" ]; then
            import_conversation_handler "$arg"
            exit $?
        fi

        PROFILE_NAME="$arg"
        TARGET_DIR="$PROFILES_DIR/$PROFILE_NAME"

        if [ ! -d "$REAL_HOME/.gemini/antigravity-cli" ]; then
            echo "Error: Default antigravity configuration not found at $REAL_HOME/.gemini/antigravity-cli"
            exit 1
        fi

        if [ -d "$TARGET_DIR" ]; then
            echo "Profile '$PROFILE_NAME' already exists at $TARGET_DIR."
            printf "Overwrite profile '%s' with host session? [y/N]: " "$PROFILE_NAME"
            read -r resp
            case "$resp" in
                [yY][eE][sS]|[yY])
                    rm -rf "$TARGET_DIR"
                    ;;
                *) echo "Aborted."; exit 0 ;;
            esac
        fi

        mkdir -p "$TARGET_DIR/.tokens"
        setup_profile_environment "$TARGET_DIR"
        local host_token=""
        if [ -f "$REAL_HOME/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
            host_token="$REAL_HOME/.gemini/antigravity-cli/antigravity-oauth-token"
        elif [ -f "$REAL_HOME/.gemini/antigravity-cli/antigravity-oauth-token.bak" ]; then
            host_token="$REAL_HOME/.gemini/antigravity-cli/antigravity-oauth-token.bak"
        fi
        if [ -n "$host_token" ]; then
            cp "$host_token" "$TARGET_DIR/.tokens/credential.txt" 2>/dev/null || true
            cp "$host_token" "$TARGET_DIR/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true
            cp "$host_token" "$TARGET_DIR/antigravity-oauth-token" 2>/dev/null || true
            chmod 600 "$TARGET_DIR/.tokens/credential.txt" "$TARGET_DIR/.gemini/antigravity-cli/antigravity-oauth-token" "$TARGET_DIR/antigravity-oauth-token" 2>/dev/null || true
        fi
        if [[ "$OSTYPE" == "darwin"* ]]; then
            local host_kc="$REAL_HOME/Library/Keychains/login.keychain-db"
            if [ -f "$host_kc" ]; then
                local host_kc_token
                host_kc_token="$(security find-generic-password -s gemini -a antigravity -w "$host_kc" 2>/dev/null || true)"
                if [ -n "$host_kc_token" ]; then
                    printf "%s" "$host_kc_token" > "$TARGET_DIR/.tokens/credential.txt"
                    chmod 600 "$TARGET_DIR/.tokens/credential.txt"
                    local kc="$TARGET_DIR/Library/Keychains/login.keychain-db"
                    mkdir -p "$TARGET_DIR/Library/Keychains"
                    [ ! -e "$kc" ] && security create-keychain -p "" "$kc" 2>/dev/null || true
                    security unlock-keychain -p "" "$kc" 2>/dev/null || true
                    security add-generic-password -U -s gemini -a antigravity -w "$host_kc_token" "$kc" 2>/dev/null || true
                fi
            fi
        fi

        echo "Profile '$PROFILE_NAME' imported from global host config!"
        ;;

    list)
        echo "Available profiles:"
        list_profiles "$PROFILES_DIR"
        ;;

    fork)
        shift
        CONV_ID=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --conversation=*|-c=*)
                    CONV_ID="${1#*=}"
                    shift
                    ;;
                --conversation|-c)
                    CONV_ID="$2"
                    shift 2
                    ;;
                *)
                    [ -z "$CONV_ID" ] && CONV_ID="$1"
                    shift
                    ;;
            esac
        done

        if [ -z "$CONV_ID" ]; then
            echo "Error: Missing conversation ID to fork. Usage: $CMD_NAME fork --conversation=<id>"
            exit 1
        fi

        SOURCE_AGY_DIR="$REAL_HOME/.gemini/antigravity-cli"
        SRC_DB="$SOURCE_AGY_DIR/conversations/$CONV_ID.db"
        SRC_BRAIN="$SOURCE_AGY_DIR/brain/$CONV_ID"

        if [ ! -f "$SRC_DB" ] && [ ! -d "$SRC_BRAIN" ]; then
            echo "Error: Conversation '$CONV_ID' not found at $SOURCE_AGY_DIR"
            exit 1
        fi

        mapfile -t PROFILES < <(ls -1 "$PROFILES_DIR" 2>/dev/null | sort || true)
        if [ "${#PROFILES[@]}" -eq 0 ]; then
            echo "Error: No profiles found in $PROFILES_DIR. Create profiles first with: $CMD_NAME new <profile_name>"
            exit 1
        fi

        FIRST_PROFILE="${PROFILES[0]}"
        echo "Forking conversation '$CONV_ID' across ${#PROFILES[@]} profiles..."
        echo ""
        echo "$CMD_NAME $FIRST_PROFILE --conversation $CONV_ID"

        for ((i=1; i<${#PROFILES[@]}; i++)); do
            P_NAME="${PROFILES[i]}"
            if command -v uuidgen >/dev/null 2>&1; then
                NEW_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
            elif [ -f /proc/sys/kernel/random/uuid ]; then
                NEW_ID=$(cat /proc/sys/kernel/random/uuid)
            else
                NEW_ID=$(python3 -c 'import uuid; print(uuid.uuid4())')
            fi

            # 1. Copy SQLite database files
            DST_DB="$SOURCE_AGY_DIR/conversations/$NEW_ID.db"
            [ -f "$SRC_DB" ] && cp -f "$SRC_DB" "$DST_DB"
            [ -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-wal" ] && cp -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-wal" "$SOURCE_AGY_DIR/conversations/$NEW_ID.db-wal"
            [ -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-shm" ] && cp -f "$SOURCE_AGY_DIR/conversations/$CONV_ID.db-shm" "$SOURCE_AGY_DIR/conversations/$NEW_ID.db-shm"

            PYTHON_BIN=""
            if command -v python3 >/dev/null 2>&1; then
                PYTHON_BIN="python3"
            elif command -v python >/dev/null 2>&1; then
                PYTHON_BIN="python"
            fi

            if [ -n "$PYTHON_BIN" ]; then
                SUM_DB="$SOURCE_AGY_DIR/conversation_summaries.db"
                "$PYTHON_BIN" - <<EOF 2>/dev/null || true
import sqlite3, uuid, datetime

src_db = '$SRC_DB'
dst_db = '$DST_DB'
sum_db = '$SUM_DB'
conv_id = '$CONV_ID'
new_id = '$NEW_ID'

old_traj = None
try:
    c_src = sqlite3.connect(f'file:{src_db}?mode=ro', uri=True)
    row_meta = c_src.execute('SELECT trajectory_id FROM trajectory_meta').fetchone()
    if row_meta:
        old_traj = row_meta[0]
    c_src.close()
except Exception:
    pass

c = sqlite3.connect(dst_db, timeout=10.0)
new_traj = str(uuid.uuid4())
c.execute('UPDATE trajectory_meta SET cascade_id = ?, trajectory_id = ?', (new_id, new_traj))
rows = c.execute('SELECT id, data FROM trajectory_metadata_blob').fetchall()
for b_id, b_data in rows:
    if b_data and conv_id.encode('utf-8') in b_data:
        patched = b_data.replace(conv_id.encode('utf-8'), new_id.encode('utf-8'))
        c.execute('UPDATE trajectory_metadata_blob SET data = ? WHERE id = ?', (patched, b_id))
c.commit()
c.execute('PRAGMA wal_checkpoint(TRUNCATE);')
c.close()

try:
    c_sum = sqlite3.connect(sum_db, timeout=10.0)
    row = c_sum.execute('SELECT * FROM conversation_summaries WHERE conversation_id = ?', (conv_id,)).fetchone()
    if row:
        cols = [d[1] for d in c_sum.execute('PRAGMA table_info(conversation_summaries)').fetchall()]
        row_dict = dict(zip(cols, row))
        raw = row_dict.get('raw_summary')
        if raw:
            raw = raw.replace(conv_id.encode('utf-8'), new_id.encode('utf-8'))
            if old_traj:
                raw = raw.replace(old_traj.encode('utf-8'), new_traj.encode('utf-8'))
            row_dict['raw_summary'] = raw
        row_dict['conversation_id'] = new_id
        row_dict['last_modified_time'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
        placeholders = ','.join(['?'] * len(cols))
        values = [row_dict[k] for k in cols]
        c_sum.execute(f"INSERT OR REPLACE INTO conversation_summaries ({','.join(cols)}) VALUES ({placeholders})", values)
        c_sum.commit()
        c_sum.execute('PRAGMA wal_checkpoint(TRUNCATE);')
    c_sum.close()
except Exception:
    pass
EOF
            fi

            # 2. Copy brain directory
            DST_BRAIN="$SOURCE_AGY_DIR/brain/$NEW_ID"
            [ -d "$SRC_BRAIN" ] && cp -rf "$SRC_BRAIN" "$DST_BRAIN"

            # 3. Copy annotations if present
            [ -f "$SOURCE_AGY_DIR/annotations/$CONV_ID.pbtxt" ] && cp -f "$SOURCE_AGY_DIR/annotations/$CONV_ID.pbtxt" "$SOURCE_AGY_DIR/annotations/$NEW_ID.pbtxt"

            # 4. Remove presence lock if exists
            rm -f "$SOURCE_AGY_DIR/presence/$NEW_ID.lock"

            echo "$CMD_NAME $P_NAME --conversation $NEW_ID"
        done
        ;;

    export|export-conversation|export-conv)
        shift
        export_conversation_handler "$@"
        ;;

    import-conversation|import-conv)
        shift
        import_conversation_handler "$@"
        ;;

    quotas|quota|quotes|quote)
        shift
        if [ -z "$COLUMNS" ]; then
            _cols=$(tput cols 2>/dev/null || stty size 2>/dev/null | awk '{print $2}' || true)
            if [ -n "$_cols" ] && [ "$_cols" -gt 0 ] 2>/dev/null; then
                export COLUMNS="$_cols"
            fi
        fi
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if [ -x "$SCRIPT_DIR/mgy-quota" ]; then
            "$SCRIPT_DIR/mgy-quota" "$@"
            exit $?
        elif command -v mgy-quota >/dev/null 2>&1; then
            mgy-quota "$@"
            exit $?
        fi

        # Fallback to agy -p "/quota" if mgy-quota is not available
        found=0
        if [ -d "$PROFILES_DIR" ]; then
            for profile in "$PROFILES_DIR"/*; do
                if [ -d "$profile" ]; then
                    found=1
                    name=$(basename "$profile")
                    echo -e "\n=== Quota for profile: $name ==="
                    setup_profile_environment "$profile"

                    if is_profile_authenticated "$profile"; then
                        if ! DBUS_SESSION_BUS_ADDRESS="" HOME="$profile" agy quota 2>/dev/null; then
                            DBUS_SESSION_BUS_ADDRESS="" HOME="$profile" agy -p "/quota"
                        fi
                    else
                        echo "Profile '$name' is not authenticated yet. Run: $CMD_NAME new $name"
                    fi
                fi
            done
        fi
        if [ "$found" -eq 0 ]; then
            echo "(no profiles found in $PROFILES_DIR)"
        fi
        ;;

    delete|rm|remove)
        shift
        PROFILE_NAME="$1"
        [ -z "$PROFILE_NAME" ] && usage
        TARGET_DIR="$PROFILES_DIR/$PROFILE_NAME"

        if [ ! -d "$TARGET_DIR" ]; then
            echo "Error: profile '$PROFILE_NAME' does not exist."
            exit 1
        fi

        printf "Are you sure you want to delete profile '%s'? [y/N]: " "$PROFILE_NAME"
        read -r resp
        case "$resp" in
            [yY][eE][sS]|[yY])
                rm -rf "$TARGET_DIR"
                echo "Profile '$PROFILE_NAME' deleted."
                ;;
            *)
                echo "Aborted."
                ;;
        esac
        ;;

    help|--help|-h)
        print_help
        exit 0
        ;;

    "")
        usage
        ;;

    conversations|history|chats)
        echo "Recent conversations:"
        DB="$REAL_HOME/.gemini/antigravity-cli/conversation_summaries.db"
        if [ -f "$DB" ] && command -v sqlite3 >/dev/null 2>&1; then
            sqlite3 -header -column "$DB" \
              "SELECT conversation_id AS ID, title AS Title, datetime(last_modified_time) AS Last_Active FROM conversation_summaries ORDER BY last_modified_time DESC LIMIT 10;"
        else
            echo "(no conversation history database found)"
        fi
        ;;

    auto)
        shift
        model_hint=$(get_model_hint_from_args "$@")
        best_detail=$(select_best_profile "" "$model_hint")
        if [ -z "$best_detail" ]; then
            show_all_depleted_alert
            exit 1
        fi
        IFS='|' read -r best_profile best_tier best_pct _ best_prov <<< "$best_detail"
        echo "==> Selected best profile: '$best_profile' [$best_tier] ($best_prov: ${best_pct}% quota available)"
        start_profile_session "$best_profile" 1 "$@"
        exit $?
        ;;

    best)
        shift
        model_hint=$(get_model_hint_from_args "$@")
        best_detail=$(select_best_profile "" "$model_hint")
        if [ -z "$best_detail" ]; then
            show_all_depleted_alert
            exit 1
        fi
        IFS='|' read -r best_profile best_tier best_pct _ best_prov <<< "$best_detail"
        echo "==> Selected best profile: '$best_profile' [$best_tier] ($best_prov: ${best_pct}% quota available)"
        start_profile_session "$best_profile" 0 "$@"
        exit $?
        ;;

    resume)
        shift
        target_prof=""
        declare -a resume_args=()
        if [ $# -eq 0 ]; then
            resume_args=("--continue")
        elif [ -d "$PROFILES_DIR/$1" ] && [[ "$1" != -* ]]; then
            target_prof="$1"
            shift
            if [ $# -eq 0 ]; then
                resume_args=("--continue")
            elif [[ "$1" != -* ]]; then
                resume_args=("--conversation" "$1" "${@:2}")
            else
                resume_args=("$@")
            fi
        elif [[ "$1" != -* ]]; then
            resume_args=("--conversation" "$1" "${@:2}")
        else
            resume_args=("$@")
        fi

        if [ -z "$target_prof" ]; then
            model_hint=$(get_model_hint_from_args "${resume_args[@]}")
            best_detail=$(select_best_profile "" "$model_hint")
            if [ -z "$best_detail" ]; then
                show_all_depleted_alert
                exit 1
            fi
            IFS='|' read -r target_prof best_tier best_pct _ best_prov <<< "$best_detail"
            echo "==> Selected best profile: '$target_prof' [$best_tier] ($best_prov: ${best_pct}% quota available)"
        fi

        start_profile_session "$target_prof" 1 "${resume_args[@]}"
        exit $?
        ;;

    -*)
        # Flags passed without an explicit profile name (e.g. mgy --conversation=<id>, mgy -c <id>, mgy --continue)
        if [ -n "$MULTIGRAVITY_DEFAULT_PROFILE" ] && [ -d "$PROFILES_DIR/$MULTIGRAVITY_DEFAULT_PROFILE" ]; then
            SELECTED_PROFILE="$MULTIGRAVITY_DEFAULT_PROFILE"
        else
            mapfile -t avail_profiles < <(ls -1 "$PROFILES_DIR" 2>/dev/null || true)
            if [ "${#avail_profiles[@]}" -eq 1 ] && [ -n "${avail_profiles[0]}" ]; then
                SELECTED_PROFILE="${avail_profiles[0]}"
            elif [ "${#avail_profiles[@]}" -eq 0 ]; then
                echo "Error: No profiles found. Create one first using: $CMD_NAME new <profile_name>"
                exit 1
            else
                model_hint=$(get_model_hint_from_args "$@")
                best_detail=$(select_best_profile "" "$model_hint")
                if [ -n "$best_detail" ]; then
                    IFS='|' read -r SELECTED_PROFILE best_tier best_pct _ best_prov <<< "$best_detail"
                    echo "==> Selected best profile: '$SELECTED_PROFILE' [$best_tier] ($best_prov: ${best_pct}% quota available)"
                else
                    echo "Multiple profiles found. Please specify which profile to run: $CMD_NAME <profile> $*"
                    echo "Available profiles:"
                    list_profiles "$PROFILES_DIR"
                    exit 1
                fi
            fi
        fi
        start_profile_session "$SELECTED_PROFILE" 0 "$@"
        exit $?
        ;;

    *)
        TARGET_DIR="$PROFILES_DIR/$1"
        if [ ! -d "$TARGET_DIR" ]; then
            echo "Error: profile '$1' does not exist. Create it first using: $CMD_NAME new $1"
            exit 1
        fi
        start_profile_session "$1" 0 "${@:2}"
        exit $?
        ;;
esac
